import React, { useEffect } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { FETCH_DATA_REQUEST } from '../store/actions';
import LoadingSpinner from '../components/LoadingSpinner';
import ErrorMessage from '../components/ErrorMessage';
import Card from '../components/Card'; // Пример компонента карточки KPI

const DashboardPage = () => {
  const dispatch = useDispatch();
  const { data, loading, error } = useSelector((state) => state.dashboard);

  useEffect(() => {
    dispatch({ type: FETCH_DATA_REQUEST });
  }, [dispatch]);

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error} />;
  if (!data) return null;

  return (
    <div className="container mx-auto p-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
      {/* Пример рендера карточек из данных */}
      {data.cards.map((card) => (
        <Card key={card.id} title={card.title} value={card.value} icon={card.icon} />
      ))}
      {/* Здесь будут рендериться графики и таблицы согласно макету */}
      {/* <Chart data={data.chartData} /> */}
      {/* <Table data={data.tableData} /> */}
    </div>
  );
};
export default DashboardPage;

(В коде выше data.cards, data.chartData — это структура вашего dashboard_data.json. Вы должны адаптировать рендер под реальную структуру данных).

