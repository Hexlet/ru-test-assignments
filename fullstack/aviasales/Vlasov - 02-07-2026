src/store/reducer.js

javascript
Копировать
import {
  FETCH_DATA_REQUEST,
  FETCH_DATA_SUCCESS,
  FETCH_DATA_FAILURE,
} from './actions';

const initialState = {
  data: null,
  loading: false,
  error: null,
};

export default function dashboardReducer(state = initialState, action) {
  switch (action.type) {
    case FETCH_DATA_REQUEST:
      return { ...state, loading: true, error: null };
    case FETCH_DATA_SUCCESS:
      return { ...state, data: action.payload, loading: false };
    case FETCH_DATA_FAILURE:
      return { ...state, error: action.payload, loading: false };
    default:
      return state;
  }
}
3.2. Redux Saga

src/store/sagas.js

javascript
Копировать
import { call, put, takeLatest } from 'redux-saga/effects';
import axios from 'axios';
import {
  FETCH_DATA_REQUEST,
  FETCH_DATA_SUCCESS,
  FETCH_DATA_FAILURE,
} from './actions';

// Worker Saga: выполняет запрос к API
function* fetchDashboardData() {
  try {
    const response = yield call(axios.get, '/api/v1/dashboard');
    yield put({ type: FETCH_DATA_SUCCESS, payload: response.data });
  } catch (error) {
    yield put({ type: FETCH_DATA_FAILURE, payload: error.message });
  }
}

// Watcher Saga: слушает действия и запускает воркеры
export default function* rootSaga() {
  yield takeLatest(FETCH_DATA_REQUEST, fetchDashboardData);
}

(Примечание: В реальном проекте URL /api/v1/dashboard должен быть проксирован на бэкенд через конфиг vite или webpack-dev-server, чтобы избежать ошибок CORS).

