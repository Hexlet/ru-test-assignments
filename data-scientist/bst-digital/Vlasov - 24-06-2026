## Код на Python

```python
from collections import Counter
from itertools import product

# Четверостишие
text = (
    "Во глубине сибирских руд Храните гордое терпенье, "
    "Не пропадёт ваш скорбный труд И дум высокое стремленье."
)

# Токенизация: убрать знаки препинания, привести к нижнему регистру, разбить на слова
import re
words = re.findall(r"[а-яё]+", text.lower())

# Для каждого слова посчитаем его буквенный состав
word_counts = [Counter(w) for w in words]

# Все уникальные буквы
all_letters = sorted(set("".join(words)))

# Максимум, сколько какой буквы может понадобиться в одном слове
max_needed = {letter: max(wc[letter] for wc in word_counts) for letter in all_letters}

# Функция расчёта прибыли для данного набора склада
def expected_profit(stock_dict):
    total_profit = 0
    
    for wc in word_counts:
        # Считаем дефицит по буквам
        deficit = 0
        possible = True
        
        for letter, needed in wc.items():
            have = stock_dict.get(letter, 0)
            if have < needed:
                deficit += needed - have
        
        if deficit == 0:
            total_profit += 40
        elif deficit == 1:
            # Можно доставить одну букву экспресс‑доставкой
            total_profit += (40 - 2)
        else:
            # Не хватает более одной буквы — неустойка
            total_profit -= 10
    
    # Вычитаем стоимость хранения
    holding_cost = sum(stock_dict.values())
    
    return (total_profit / len(word_counts)) - holding_cost

# Перебор всех разумных комбинаций
# Для каждой буквы количество на складе от 0 до max_needed[letter]
ranges = [range(max_needed[l] + 1) for l in all_letters]

best_profit = float("-inf")
best_stock = None

for combo in product(*ranges):
    stock_dict = dict(zip(all_letters, combo))
    profit = expected_profit(stock_dict)
    if profit > best_profit:
        best_profit = profit
        best_stock = stock_dict

print("Оптимальный набор на складе:", best_stock)
print("Ожидаемая дневная прибыль:", round(best_profit, 2))
```

