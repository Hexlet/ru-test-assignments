class GistDetailViewController: UIViewController {
    let gistID: String
    @State private var gist: Gist?
    @State private var isLoading = false
    @State private var errorMessage: String? = nil

    private let client = GitHubClient()

    init(gistID: String) {
        self.gistID = gistID
        super.init(nibName: nil, bundle: nil)
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        title = "Gist Details"
        loadGist()
    }

    private func loadGist() {
        isLoading = true
        Task {
            do {
                self.gist = try await client.fetchGist(by: self.gistID)
            } catch {
                self.errorMessage = error.localizedDescription
            }
            self.isLoading = false
        }
    }

    private func contentText(for file: GitHubClient.GistFile) -> String {
        return file.content ?? "(no content)"
    }

    // Пример простого UI: UILabel для description, UITextView для содержимого файла
    // В реальном приложении лучше сделать UITableView со списком файлов
}
UI можно сделать через Storyboard/XIB или программно. Для теста достаточно простого:
•	Если isLoading → UIActivityIndicatorView
•	Если errorMessage → показать UIAlertController или метку с ошибкой
•	Если gist есть → отобразить описание и содержимое первого файла (или список файлов)
