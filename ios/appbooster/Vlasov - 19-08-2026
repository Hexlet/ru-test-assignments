@MainActor
class GistsViewModel: ObservableObject {
    @Published var gists: [Gist] = []
    @Published var isLoading = false
    @Published var errorMessage: String? = nil
    @Published var hasMore = true
    @Published var currentPage = 1

    private let client = GitHubClient()
    private var username: String!

    func start(for username: String) {
        self.username = username
        Task {
            await loadMore()
        }
    }

    func loadMore() async {
        guard !isLoading, hasMore else { return }
        isLoading = true
        errorMessage = nil

        do {
            let newGists = try await client.fetchGists(for: username, page: currentPage)
            if newGists.isEmpty {
                hasMore = false
            } else {
                gists.append(contentsOf: newGists)
                currentPage += 1
                hasMore = newGists.count == 20 // эвристика: если ровно 20, вероятно, есть ещё
            }
        } catch {
            errorMessage = error.localizedDescription
            hasMore = false // чтобы не спамить запросами при ошибке
        }
        isLoading = false
    }

    func refresh() async {
        currentPage = 1
        hasMore = true
        gists.removeAll()
        await loadMore()
    }
}
