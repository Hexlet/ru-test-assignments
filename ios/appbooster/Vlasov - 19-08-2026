Network layer
Базовый клиент для запросов к GitHub:
swift
ПереноситьСвернутьКопировать
enum GitHubAPIError: Error {
    case invalidResponse
    case decodingError
    case networkError(Error)
    case notFound
}

class GitHubClient {
    private let baseURL = URL(string: "https://api.github.com")!

    func fetchGists(for username: String, page: Int, perPage: Int = 20) async throws -> [Gist] {
        var components = URLComponents(url: baseURL.appendingPathComponent("users/\(username)/gists"), resolvingAgainstBaseURL: false)!
        components.queryItems = [
            URLQueryItem(name: "page", value: "\(page)"),
            URLQueryItem(name: "per_page", value: "\(perPage)")
        ]

        guard let url = components.url else { throw GitHubAPIError.invalidResponse }

        let (data, response) = try await URLSession.shared.data(from: url)
        guard let httpResponse = response as? HTTPURLResponse else { throw GitHubAPIError.invalidResponse }

        switch httpResponse.statusCode {
        case 200: break
        case 404: throw GitHubAPIError.notFound
        default: throw GitHubAPIError.networkError(NSError(domain: "GitHub", code: httpResponse.statusCode))
        }

        do {
            return try JSONDecoder().decode([Gist].self, from: data)
        } catch {
            throw GitHubAPIError.decodingError
        }
    }

    func fetchGist(by id: String) async throws -> Gist {
        let url = baseURL.appendingPathComponent("gists/\(id)")
        let (data, response) = try await URLSession.shared.data(from: url)
        guard let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode == 200 else {
            throw GitHubAPIError.notFound
        }
        return try JSONDecoder().decode(Gist.self, from: data)
    }
}
