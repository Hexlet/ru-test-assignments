using System;
using System.Collections.Generic;
using System.Linq;

public class HanabiCard
{
    public string Color { get; }
    public int Rank { get; }
    
    public HanabiCard(string color, int rank)
    {
        Color = color;
        Rank = rank;
    }
}

public enum ActionType
{
    Play,
    Drop,
    TellColor,
    TellRank
}

public class HanabiAction
{
    public ActionType Type { get; set; }
    public List<int> Cards { get; set; } // индексы карт в руке
    public object Value { get; set; }   // цвет или ранг для подсказок
}

public class HanabiPlayer
{
    private readonly List<HanabiCard> _hand;
    
    public HanabiPlayer()
    {
        _hand = new List<HanabiCard>();
    }
    
    public void AddCard(HanabiCard card) => _hand.Add(card);
    
    public HanabiCard GetCard(int index) => _hand[index];
    
    public bool RemoveCard(int index)
    {
        if (index >= 0 && index < _hand.Count)
        {
            _hand.RemoveAt(index);
            return true;
        }
        
        return false;
    }
    
    public void DrawCard(HanabiCard card) => _hand.Insert(0, card); 
}

public class HanabiGame
{
    private static Dictionary<string, int> _colorCounts = new();
    private static HashSet<(string, int)> _playedCards = new();
    private static int _riskyPlaysCount = 0;
    private static int _turnNumber = 0;
    private static bool _gameEnded = false;
    
    private HanabiPlayer[] players = new HanabiPlayer[2];
    private Queue<HanabiCard> deck;
    private Stack<HanabiCard> discardPile = new();
    
    public HanabiGame(List<HanabiCard> initialDeck)
    {
        players[0] = new HanabiPlayer();
        players[1] = new HanabiPlayer();
        
        foreach(var player in players)
        {
            for(int i = 0; i < 5; ++i)
                player.DrawCard(initialDeck[i]);
            
            initialDeck.RemoveRange(0, 5);
        }
        
        deck = new Queue<HanabiCard>(initialDeck);
    }
    
    public void ProcessAction(HanabiAction action)
    {
        if (_gameEnded || !_ValidateAction(action))
            return;
        
        switch (action.Type)
        {
            case ActionType.Play:
                var currentPlayerIndex = _turnNumber % 2;
                var playedCard = players[currentPlayerIndex].GetCard(action.Cards.First());
                
                if (!_IsValidPlay(playedCard.Color, playedCard.Rank))
                    _EndGame("Invalid play");
                else
                {
                    players[currentPlayerIndex].RemoveCard(action.Cards.First());
                    
                    if(deck.Any())
                        players[currentPlayerIndex].DrawCard(deck.Dequeue());
                        
                    _playedCards.Add((playedCard.Color, playedCard.Rank));
                    _UpdateColorCounts(playedCard.Color, playedCard.Rank);
                    
                    if(_CheckWinCondition()) 
                        _EndGame("All cards placed successfully!");
                }
                break;
            case ActionType.Drop:
                var droppedCard = players[_turnNumber % 2].GetCard(action.Cards.First());
                players[_turnNumber % 2].RemoveCard(action.Cards.First());
                
                if(deck.Any())
                    players[_turnNumber % 2].DrawCard(deck.Dequeue());
                
                discardPile.Push(droppedCard);
                break;
            default:
                throw new NotImplementedException($"Unsupported action type: {action.Type}");
        }
        
        _turnNumber++;
    }
    
    private bool _ValidateAction(HanabiAction action)
    {
        if (_gameEnded)
            return false;
        
        if (deck.Count == 0)
        {
            _EndGame("No more cards in the deck.");
            return false;
        }
        
        return true;
    }
    
    private bool _IsValidPlay(string color, int rank)
    {
        if(rank != 1 && !_colorCounts.ContainsKey(color)) 
            return false;
        
        if(rank > _colorCounts.GetValueOrDefault(color) + 1)
            return false;
        
        return true;
    }
    
    private void _UpdateColorCounts(string color, int rank)
    {
        if(!_colorCounts.ContainsKey(color))
            _colorCounts[color] = rank;
        else
            _colorCounts[color]++;
    }
    
    private bool _CheckWinCondition() =>
        _playedCards.Count == 25 ? true : false;
    
    private void _EndGame(string reason)
    {
        Console.WriteLine(
            $"Turn: {_turnNumber}, cards: {_playedCards.Count}, with risk: {_riskyPlaysCount}"
        );
        
        _gameEnded = true;
    }
}

class Program
{
    static void Main(string[] args)
    {
        while(true)
        {
            string line = Console.ReadLine();
            if(line == null)
                break;
            
            if(line.StartsWith("Start"))
            {
                var game = ParseAndInitializeGame(line);
                RunGame(game);
            }
        }
    }
    
    static HanabiGame ParseAndInitializeGame(string startCommand)
    {
        var parts = startCommand.Split(' ');
        var deckString = parts.SkipWhile(p => p != "with").Skip(1).First().TrimEnd(',');
        var deckParts = deckString.Split(' ').Select(s => s.Trim()).ToList();
        
        var cards = deckParts.Select(c => new HanabiCard(c.Substring(0, 1), int.Parse(c.Substring(1))))
                            .ToList();
                            
        return new HanabiGame(cards);
    }
    
    static void RunGame(HanabiGame game)
    {
        while(true)
        {
            string command = Console.ReadLine();
            if(command == null)
                break;
            
            var action = ParseAction(command);
            game.ProcessAction(action);
        }
    }
    
    static HanabiAction ParseAction(string command)
    {
        var tokens = command.Split(' ');
        var actionType = tokens[0];
        
        HanabiAction result = new HanabiAction();
        
        switch(actionType)
        {
            case "Play":
                result.Type = ActionType.Play;
                result.Cards = new List<int>() {int.Parse(tokens[2])};
                break;
            case "Drop":
                result.Type = ActionType.Drop;
                result.Cards = new List<int>() {int.Parse(tokens[2])};
                break;
            case "Tell":
                result.Type = tokens[1] == "color" ? ActionType.TellColor : ActionType.TellRank;
                result.Value = tokens[2];
                result.Cards = tokens.Skip(4).TakeWhile(t => t.All(char.IsDigit)).Select(int.Parse).ToList();
                break;
            default:
                throw new ArgumentException($"Unknown action type: {actionType}");
        }
        
        return result;
    }
}
