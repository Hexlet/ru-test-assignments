public sealed class Circle : IShape
{
    public double Radius { get; }

    public Circle(double radius)
    {
        if (radius <= 0) throw new ArgumentException("Радиус должен быть больше нуля.", nameof(radius));
        Radius = radius;
    }

    public double CalculateArea() => Math.PI * Radius * Radius;
}

Класс треугольника со статическим фабричным методом для валидации существования фигуры по неравенству треугольника:

csharp
public sealed class Triangle : IShape
{
    public double SideA { get; }
    public double SideB { get; }
    public double SideC { get; }

    private Triangle(double a, double b, double c)
    {
        SideA = a;
        SideB = b;
        SideC = c;
    }

    // Фабричный метод вместо конструктора для безопасной валидации
    public static Triangle Create(double a, double b, double c)
    {
        if (a <= 0 || b <= 0 || c <= 0) 
            throw new ArgumentException("Стороны должны быть больше нуля.");
        
        // Неравенство треугольника
        if (a + b <= c || a + c <= b || b + c <= a)
            throw new ArgumentException("Из данных сторон невозможно составить треугольник.");

        return new Triangle(a, b, c);
    }

    public double CalculateArea()
    {
        // Формула Герона
        var p = (SideA + SideB + SideC) / 2;
        return Math.Sqrt(p * (p - SideA) * (p - SideB) * (p - SideC));
    }

    public bool IsRightAngled()
    {
        // Сортируем стороны, чтобы гипотенузой всегда была самая длинная
        var sides = new[] { SideA, SideB, SideC };
        Array.Sort(sides);
        
        // Проверка по теореме Пифагора с допуском на погрешность вещественных чисел
        const double epsilon = 1e-10;
        return Math.Abs(Math.Pow(sides[0], 2) + Math.Pow(sides[1], 2) - Math.Pow(sides[2], 2)) < epsilon;
    }
}

Абстрактная фабрика для создания фигур без знания их конкретного типа (полезна при парсинге пользовательского ввода):

csharp
public static class ShapeFactory
{
    public static IShape Create(string type, params double[] parameters)
    {
        return type.ToLowerInvariant() switch
        {
            "circle" when parameters.Length == 1 => new Circle(parameters[0]),
            "triangle" when parameters.Length == 3 => Triangle.Create(parameters[0], parameters[1], parameters[2]),
            _ => throw new NotSupportedException($"Тип фигуры '{type}' не поддерживается.")
        };
    }
}
