$farm = new Farm();

// 1. Добавляем 10 коров и 20 кур
for ($i = 0; $i < 10; $i++) {
    $farm->createAndAddAnimal(fn(int $id) => new Cow($id));
}
for ($i = 0; $i < 20; $i++) {
    $farm->createAndAddAnimal(fn(int $id) => new Chicken($id));
}

// Выводим количество каждого типа животных
echo "Количество животных на ферме:\n";
foreach ($farm->getStatsByType() as $type => $count) {
    echo "$type: $count\n";
}
echo "\n";

// 2. 7 раз (неделя) собираем продукцию
$weeklyTotals = ['milk' => 0.0, 'eggs' => 0];

for ($day = 1; $day <= 7; $day++) {
    $daily = $farm->collectAll();
    $weeklyTotals['milk'] += $daily['milk'] ?? 0;
    $weeklyTotals['eggs'] += $daily['eggs'] ?? 0;
}

echo "Собрано за неделю:\n";
echo "Молоко: {$weeklyTotals['milk']} л\n";
echo "Яйца: {$weeklyTotals['eggs']} шт\n\n";

