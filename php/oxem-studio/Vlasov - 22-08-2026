<?php

declare(strict_types=1);

class Farm
{
    /** @var Animal[] */
    private array $animals = [];

    private int $nextId = 1;

    /**
     * Добавить животное на ферму.
     */
    public function addAnimal(Animal $animal): void
    {
        $this->animals[] = $animal;
    }

    /**
     * Автоматически создать и добавить животное с новым уникальным ID.
     */
    public function createAndAddAnimal(callable $factory): Animal
    {
        $animal = $factory($this->nextId++);
        $this->addAnimal($animal);
        return $animal;
    }

    /**
     * Собрать продукцию у всех животных.
     * Возвращает ассоциативный массив: тип продукции => суммарное количество.
     */
    public function collectAll(): array
    {
        $totals = [];

        foreach ($this->animals as $animal) {
            foreach ($animal->collect() as $product) {
                if (!isset($totals[$product->type])) {
                    $totals[$product->type] = 0.0;
                }
                $totals[$product->type] += $product->amount;
            }
        }

        return $totals;
    }

    /**
     * Получить статистику по типам животных.
     * Ключ — имя класса (Cow, Chicken и т.д.), значение — количество.
     */
    public function getStatsByType(): array
    {
        $stats = [];
        foreach ($this->animals as $animal) {
            $className = get_class($animal);
            if (!isset($stats[$className])) {
                $stats[$className] = 0;
            }
            $stats[$className]++;
        }
        return $stats;
    }

    public function countAnimals(): int
    {
        return count($this->animals);
    }
}
