2. База данных
Для хранения логов потребуется создать таблицу. Логика создания прописывается в файле func.php через хук install.
Файл: app/addons/order_status_history/func.php
phpКопировать
<?php

if (!defined('BOOTSTRAP')) { die('Access denied'); }

use Tygh\Registry;
use Tygh\Database;

function fn_order_status_history_install()
{
    $db = Database::getInstance();
    
    // Проверка на существование перед созданием (на случай повторной установки)
    if (!$db->hasTable('?:order_status_history')) {
        $db->query("CREATE TABLE IF NOT EXISTS ?:order_status_history (
            history_id INT(11) UNSIGNED NOT NULL AUTO_INCREMENT,
            order_id INT(11) UNSIGNED NOT NULL DEFAULT 0,
            old_status CHAR(32) NOT NULL DEFAULT '',
            new_status CHAR(32) NOT NULL DEFAULT '',
            user_id INT(11) UNSIGNED NOT NULL DEFAULT 0,
            timestamp INT(11) UNSIGNED NOT NULL DEFAULT 0,
            PRIMARY KEY (history_id),
            INDEX order_id (order_id),
            INDEX timestamp (timestamp)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8;");
    }
}

function fn_order_status_history_uninstall()
{
    $db = Database::getInstance();
    $db->query("DROP TABLE IF EXISTS ?:order_status_history");
}
3. Отслеживание события (Pre-контроллер)
Стандартный способ перехвата смены статуса — использование pre-контроллера общего контроллера заказов.
Файл: app/addons/order_status_history/controllers/common/orders.pre.php
phpКопировать
<?php

use Tygh\Registry;

if (!defined('BOOTSTRAP')) { die('Access denied'); }

// Перехватываем смену статуса только при POST-запросе из админки или API
if ($_SERVER['REQUEST_METHOD'] == 'POST' && ($mode == 'update_status' || $mode == 'change_status')) {
    
    $order_id = isset($_REQUEST['order_id']) ? intval($_REQUEST['order_id']) : 0;
    $new_status = isset($_REQUEST['status']) ? $_REQUEST['status'] : '';
    
    // Получаем текущий статус заказа до его изменения
    $old_status = db_get_field("SELECT status FROM ?:orders WHERE order_id = ?i", $order_id);

    // Регистрируем постконтроллер для записи в БД после успешного обновления основного статуса
    Registry::register('post_controllers', 'common/orders.change_status', function() use ($order_id, $old_status, $new_status) {
        
        // Если статус не изменился, ничего не делаем
        if ($old_status == $new_status) {
            return;
        }

        $data = [
            'order_id' => $order_id,
            'old_status' => $old_status,
            'new_status' => $new_status,
            'user_id' => !empty(Tygh::$app['session']['auth']['user_id']) ? Tygh::$app['session']['auth']['user_id'] : 0,
            'time' => time()
        ];
        
        db_query("INSERT INTO ?:order_status_history ?e", $data);
    });
}
