5. Страница в админке (Контроллер и Шаблон)
Контроллер получает данные из кастомной таблицы и передает их в Smarty.
Файл: app/addons/order_status_history/controllers/backend/orders.post.php
phpКопировать
<?php

use Tygh\Registry;

if (!defined('BOOTSTRAP')) { die('Access denied'); }

if ($mode == 'history') {
    
    $params = $_REQUEST;
    
    // Настройки пагинации
    list($history_data, $search) = OrdersHistoryRepository::find($params);
    
    Registry::get('view')->assign('history_data', $history_data);
    Registry::get('view')->assign('search', $search);
}

// Репозиторий лучше вынести в отдельный класс, но для примера оставим здесь
class OrdersHistoryRepository 
{
    public static function find($params)
    {
        $default_params = [
            'page' => 1,
            'items_per_page' => 20
        ];
        
        $params = array_merge($default_params, $params);
        
        $condition = [];
        
        if (!empty($params['order_id'])) {
            $condition[] = db_quote("order_id = ?i", $params['order_id']);
        }
        
        $limit = db_paginate($params['page'], $params['items_per_page']);
        
        $history_data = db_get_array(
            "SELECT * FROM ?:order_status_history " . implode(' ', $condition) . " ORDER BY timestamp DESC $limit"
        );
        
        foreach ($history_data as &$row) {
            // Имя пользователя можно получить сразу запросом JOIN, но для простоты дергаем отдельно
            $row['user_name'] = fn_get_user_name($row['user_id']);
        }
        
        $total_items = db_get_field("SELECT COUNT(*) FROM ?:order_status_history " . implode(' ', $condition));
        
        return [$history_data, ['total_items' => $total_items]];
    }
}
