import time
import threading
from typing import Any, Dict, List, Optional, Union

CacheValue = Union[str, List[Any], Dict[str, Any]]

class InMemoryCache:
    def __init__(self):
        self._store: Dict[str, Dict[str, Any]] = {}
        self._lock = threading.Lock()
        # Фоновый поток для очистки expired ключей
        self._cleaner = threading.Thread(target=self._clean_expired, daemon=True)
        self._cleaner.start()

    def _clean_expired(self):
        while True:
            time.sleep(60) # Проверка раз в минуту
            with self._lock:
                now = time.time()
                expired_keys = [k for k, v in self._store.items() if v.get('expires_at') and v['expires_at'] < now]
                for key in expired_keys:
                    del self._store[key]

    def get(self, key: str) -> Optional[CacheValue]:
        with self._lock:
            if key not in self._store:
                return None
            if self._store[key].get('expires_at') and self._store[key]['expires_at'] < time.time():
                del self._store[key]
                return None
            return self._store[key]['value']

    def set(self, key: str, value: CacheValue, ttl: Optional[int] = None):
        with self._lock:
            expires_at = time.time() + ttl if ttl else None
            self._store[key] = {'value': value, 'expires_at': expires_at}

    def delete(self, key: str) -> bool:
        with self._lock:
            if key in self._store:
                del self._store[key]
                return True
            return False

    def keys(self, pattern: Optional[str] = None) -> List[str]:
        with self._lock:
            keys = list(self._store.keys())
            if pattern:
                # Простая поддержка wildcard *
                pattern = pattern.replace('*', '.*')
                import re
                return [k for k in keys if re.match(f"^{pattern}$", k)]
            return keys
