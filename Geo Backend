app/api.py (REST API)
pythonКопировать
from fastapi import APIRouter, HTTPException
from app.cache import cache
from app.models import SetRequest, GetResponse, KeysResponse

router = APIRouter(prefix="/cache", tags=["cache"])

@router.get("/{key}", response_model=GetResponse)
async def api_get(key: str):
    value = cache.get(key)
    return GetResponse(value=value, exists=value is not None)

@router.post("/set")
async def api_set(req: SetRequest):
    cache.set(req.key, req.value, req.ttl)
    return {"status": "OK"}

@router.delete("/{key}")
async def api_del(key: str):
    if not cache.delete(key):
        raise HTTPException(status_code=404, detail="Key not found")
    return {"status": "OK"}

@router.get("/keys", response_model=KeysResponse)
async def api_keys(pattern: Optional[str] = None):
    return KeysResponse(keys=cache.keys(pattern))
app/tcp.py (TCP/Telnet протокол)
pythonКопировать
import asyncio
from app.cache import cache

async def handle_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    addr = writer.get_extra_info('peername')
    print(f"New connection from {addr}")
    
    while True:
        data = await reader.readuntil(b'\n')
        if not data:
            break
        
        command = data.decode().strip().split()
        if not command:
            continue
        
        resp = b"+OK\r\n"
        
        try:
            if command[0].upper() == "SET" and len(command) >= 3:
                key = command[1]
                value = " ".join(command[2:])
                # Проверка на TTL: SET key value [TTL]
                if len(command) == 4:
                    ttl = int(command[3])
                    cache.set(key, value, ttl)
                else:
                    cache.set(key, value)
            
            elif command[0].upper() == "GET" and len(command) == 2:
                value = cache.get(command[1])
                if value is None:
                    resp = b"$-1\r\n"
                else:
                    val_str = str(value)
                    resp = f"${len(val_str)}\r\n{val_str}\r\n".encode()

            elif command[0].upper() == "DEL" and len(command) == 2:
                if cache.delete(command[1]):
                    resp = b":1\r\n"
                else:
                    resp = b":0\r\n"

            elif command[0].upper() == "KEYS" and len(command) <= 2:
                pattern = command[1] if len(command) == 2 else None
                keys = cache.keys(pattern)
                keys_str = " ".join(keys)
                resp = f"*{len(keys)}\r\n".encode()
                for k in keys:
                    resp += f"${len(k)}\r\n{k}\r\n".encode()

            else:
                resp = b"-ERR unknown command\r\n"
        except Exception as e:
            resp = f"-ERR {str(e)}\r\n".encode()

        writer.write(resp)
        await writer.drain()

    writer.close()
    await writer.wait_closed()
    print(f"Connection closed from {addr}")
app/main.py (Точка входа)
pythonКопировать
import asyncio
import uvicorn
from fastapi import FastAPI
from app.api import router as api_router
from app.tcp import handle_client

app = FastAPI(title="Geo Unit In-Memory Cache")
app.include_router(api_router)

@app.on_event("startup")
async def startup_event():
    # Запуск TCP сервера в фоне при старте приложения
    asyncio.create_task(asyncio.start_server(handle_client, "0.0.0.0", 6379))
    print("TCP Server started on port 6379")

if __name__ == "__main__":
    uvicorn.run("app.main:app", host="0.0.0.0", port=8000, reload=True)
