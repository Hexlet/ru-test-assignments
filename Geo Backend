import pytest
from app.cache import cache

@pytest.fixture(autouse=True)
def clear_cache():
    # Очищаем хранилище перед каждым тестом
    for key in list(cache._store.keys()):
        cache.delete(key)

def test_set_get_string():
    cache.set("test_str", "hello")
    assert cache.get("test_str") == "hello"

def test_set_get_dict():
    cache.set("test_dict", {"a": 1, "b": 2})
    assert cache.get("test_dict") == {"a": 1, "b": 2}

def test_ttl_expiration():
    cache.set("test_ttl", "temp", ttl=1)
    assert cache.get("test_ttl") == "temp"
    import time
    time.sleep(1.1)
    assert cache.get("test_ttl") is None

def test_delete():
    cache.set("del_key", "value")
    assert cache.delete("del_key") is True
    assert cache.get("del_key") is None
    assert cache.delete("non_existent") is False

def test_keys_pattern():
    cache.set("user:1", "data1")
    cache.set("user:2", "data2")
    cache.set("admin:1", "admin")
    keys = cache.keys("user:*")
    assert set(keys) == {"user:1", "user:2"}
