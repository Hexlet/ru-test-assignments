import json
from django import template
from django.urls import resolve, Resolver404
from .models import MenuItem

register = template.Library()


def _find_active_item(menu_items, current_path, resolved_viewname):
    for item in menu_items:
        # Сравнение по абсолютному пути
        if item.get_absolute_url() == current_path:
            return item
        
        # Сравнение по именованному URL (если задан именно named url)
        if item.url and not item.url.startswith('/') and not item.url.startswith('http'):
            try:
                match = resolve(item.url)
                if match.view_name == resolved_viewname:
                    return item
            except Resolver404:
                continue
    return None


@register.simple_tag(takes_context=True)
def draw_menu(context, menu_name):
    request = context['request']
    current_path = request.path_info

    # Попытка определить текущее именованное представление
    resolved_viewname = None
    try:
        match = resolve(current_path)
        resolved_viewname = match.view_name
    except Resolver404:
        pass

    # ГАРАНТИРОВАННО 1 ЗАПРОС К БД: получаем все узлы нужного меню
    all_items = list(MenuItem.objects.filter(menu_name=menu_name))
    
    active_item = _find_active_item(all_items, current_path, resolved_viewname)

    # Если активный пункт не найден (ошибка в URL или главная страница), раскрываем корень
    if not active_item:
        root_prefix = ''
    else:
        # Строим префикс пути, который должен быть раскрыт:
        # - Все предки активного узла
        # - Сам активный узел
        # - Его дети первого уровня
        ancestors_ids = [int(x) for x in active_item.path.split('.') if x]
        children_first_level_ids = [
            int(i.id) for i in all_items 
            if i.path.startswith(active_item.path) and i.path.count('.') == active_item.path.count('.') + 1
        ]
        ids_to_expand = set(ancestors_ids + [active_item.id] + children_first_level_ids)
        
        # Префикс строится на основе путей этих ID
        id_to_path = {item.id: item.path for item in all_items}
        paths_to_expand = {id_to_path[i] for i in ids_to_expand if i in id_to_path}
        root_prefix = min(paths_to_expand, key=len) if paths_to_expand else ''

    # Фильтруем только те элементы, которые входят в развернутую ветку
    visible_items = [
        {
            'id': item.id,
            'title': item.title,
            'url': item.get_absolute_url(),
            'level': item.path.count('.'),
            'is_active': item.id == active_item.id if active_item else False,
            'has_children': any(child.path.startswith(item.path) and child.path.count('.') == item.path.count('.') + 1 for child in all_items)
        }
        for item in all_items
        if item.path.startswith(root_prefix)
    ]

    return {'items': visible_items, 'current_path': current_path}
