from django.db import models
from django.urls import reverse, NoReverseMatch


class MenuItem(models.Model):
    MENU_NAME_MAX_LENGTH = 100
    TITLE_MAX_LENGTH = 200
    URL_MAX_LENGTH = 200

    title = models.CharField('Заголовок', max_length=TITLE_MAX_LENGTH)
    # Пустой для корня, вида '.{id}.' для потомков (Materialized Path)
    path = models.CharField('Путь', max_length=URL_MAX_LENGTH, default='', db_index=True)
    parent = models.ForeignKey(
        'self',
        verbose_name='Родитель',
        on_delete=models.CASCADE,
        null=True,
        blank=True,
        related_name='children'
    )
    menu_name = models.CharField('Название меню', max_length=MENU_NAME_MAX_LENGTH, db_index=True)
    
    # Может быть пустым для разделителей или заголовков групп
    url = models.CharField('URL или named URL', max_length=URL_MAX_LENGTH, blank=True)
    
    class Meta:
        unique_together = ('menu_name', 'path')
        ordering = ['path']
        verbose_name = 'Пункт меню'
        verbose_name_plural = 'Пункты меню'

    def __str__(self):
        return self.title

    def save(self, *args, **kwargs):
        # Автоматическое формирование materialized path
        if not self.path:
            if self.parent_id is None:
                self.path = ''
            else:
                self.path = f"{self.parent.path}{self.parent.id}."
        super().save(*args, **kwargs)

    def get_absolute_url(self):
        """
        Возвращает реальный URL. Если в поле url указан named url, пытается его разрешить.
        """
        if not self.url:
            return '#'
        try:
            return reverse(self.url)
        except NoReverseMatch:
            return self.url
