## src/Router.php

```php
<?php

declare(strict_types=1);

namespace AdsApi;

final class Router
{
    public function __construct(private AdService $service) {}

    public function handle(): void
    {
        $method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
        $path = $_SERVER['PATH_INFO'] ?? '';

        try {
            switch ($method) {
                case 'POST':
                    if ($path === '/ads') {
                        $this->handleCreate();
                        return;
                    }
                    if (preg_match('#^/ads/(\d+)$#', $path, $matches)) {
                        $this->handleUpdate((int)$matches[1]);
                        return;
                    }
                    break;
                case 'GET':
                    if ($path === '/ads/relevant') {
                        $this->handleRelevant();
                        return;
                    }
                    break;
            }

            $this->respondJson(404, 'Not found');
        } catch (\InvalidArgumentException $e) {
            $this->respondJson(400, $e->getMessage());
        } catch (\Exception $e) {
            error_log($e->getMessage());
            $this->respondJson(500, 'Internal server error');
        }
    }

    private function handleCreate(): void
    {
        parse_str(file_get_contents('php://input'), $data);

        $text = $data['text'] ?? '';
        $price = $data['price'] ?? null;
        $limit = $data['limit'] ?? null;
        $banner = $data['banner'] ?? '';

        $ad = $this->service->createAd($text, (float)$price, (int)$limit, $banner);

        $this->respondJson(200, 'OK', [
            'id'     => $ad->id,
            'text'   => $ad->text,
            'banner' => $ad->banner,
        ]);
    }

    private function handleUpdate(int $id): void
    {
        parse_str(file_get_contents('php://input'), $data);

        $text = isset($data['text']) ? $data['text'] : null;
        $price = isset($data['price']) ? (float)$data['price'] : null;
        $limit = isset($data['limit']) ? (int)$data['limit'] : null;
        $banner = isset($data['banner']) ? $data['banner'] : null;

        $updated = $this->service->updateAd($id, $text, $price, $limit, $banner);
        if (!$updated) {
            $this->respondJson(404, 'Ad not found');
            return;
        }

        $this->respondJson(200, 'OK', [
            'id'     => $updated->id,
            'text'   => $updated->text,
            'banner' => $updated->banner,
        ]);
    }

    private function handleRelevant(): void
    {
        $ad = $this->service->getRelevantAd();
        if (!$ad) {
            $this->respondJson(200, 'No relevant ad', []);
            return;
        }

        $this->respondJson(200, 'OK', [
            'id'     => $ad->id,
            'text'   => $ad->text,
            'banner' => $ad->banner,
        ]);
    }

    private function respondJson(int $code, string $message, array $data = []): void
    {
        http_response_code($code);
        header('Content-Type: application/json');
        echo json_encode([
            'message' => $message,
            'code'    => $code,
            'data'    => $data,
        ], JSON_UNESCAPED_UNICODE);
    }
}
