## src/AdService.php

```php
<?php

declare(strict_types=1);

namespace AdsApi;

class AdService
{
    public function __construct(private AdStorage $storage) {}

    public function createAd(string $text, float $price, int $limit, string $banner): Ad
    {
        Validator::validateText($text);
        Validator::validatePrice($price);
        Validator::validateLimit($limit);
        Validator::validateBanner($banner);

        $ad = new Ad(0, $text, $price, $limit, $banner, 0);
        return $this->storage->create($ad);
    }

    public function updateAd(int $id, ?string $text, ?float $price, ?int $limit, ?string $banner): ?Ad
    {
        $existing = $this->storage->findById($id);
        if (!$existing) {
            return null;
        }

        if ($text !== null) Validator::validateText($text);
        if ($price !== null) Validator::validatePrice($price);
        if ($limit !== null) Validator::validateLimit($limit);
        if ($banner !== null) Validator::validateBanner($banner);

        $existing->text = $text ?? $existing->text;
        $existing->price = $price ?? $existing->price;
        $existing->limit = $limit ?? $existing->limit;
        $existing->banner = $banner ?? $existing->banner;

        $this->storage->update($existing);
        return $existing;
    }

    /**
     * Возвращает релевантное объявление для показа.
     * Алгоритм: max(price * (limit - shown)), при этом shown < limit.
     */
    public function getRelevantAd(): ?Ad
    {
        $ads = $this->storage->getAll();
        $best = null;
        $bestScore = -1;

        foreach ($ads as $ad) {
            if ($ad->shown >= $ad->limit) {
                continue;
            }
            // Хитрый алгоритм: учитываем и цену, и остаток лимита
            $score = $ad->price * ($ad->limit - $ad->shown);
            if ($score > $bestScore) {
                $bestScore = $score;
                $best = $ad;
            }
        }

        if ($best) {
            $this->storage->incrementShown($best->id);
        }

        return $best;
    }
}
