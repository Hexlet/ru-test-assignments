## src/AdStorage.php

```php
<?php

declare(strict_types=1);

namespace AdsApi;

use PDO;
use PDOException;

class AdStorage
{
    private PDO $pdo;

    public function __construct(string $dsn)
    {
        $this->pdo = new PDO($dsn, '', '', [
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        ]);
        $this->initSchema();
    }

    private function initSchema(): void
    {
        $sql = <<<SQL
        CREATE TABLE IF NOT EXISTS ads (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            text TEXT NOT NULL,
            price REAL NOT NULL,
            limit_count INTEGER NOT NULL,
            banner TEXT NOT NULL,
            shown INTEGER NOT NULL DEFAULT 0
        );
        SQL;
        $this->pdo->exec($sql);
    }

    public function create(Ad $ad): Ad
    {
        $stmt = $this->pdo->prepare(
            'INSERT INTO ads (text, price, limit_count, banner, shown) VALUES (:text, :price, :limit, :banner, :shown)'
        );
        $stmt->execute([
            ':text'   => $ad->text,
            ':price'  => $ad->price,
            ':limit'  => $ad->limit,
            ':banner' => $ad->banner,
            ':shown'  => $ad->shown,
        ]);
        $ad->id = (int)$this->pdo->lastInsertId();
        return $ad;
    }

    public function findById(int $id): ?Ad
    {
        $stmt = $this->pdo->prepare('SELECT * FROM ads WHERE id = :id');
        $stmt->execute([':id' => $id]);
        $row = $stmt->fetch();
        return $row ? Ad::createFromRow($row) : null;
    }

    public function update(Ad $ad): void
    {
        $stmt = $this->pdo->prepare(
            'UPDATE ads SET text = :text, price = :price, limit_count = :limit, banner = :banner WHERE id = :id'
        );
        $stmt->execute([
            ':id'    => $ad->id,
            ':text'  => $ad->text,
            ':price' => $ad->price,
            ':limit' => $ad->limit,
            ':banner'=> $ad->banner,
        ]);
    }

    public function getAll(): array
    {
        $rows = $this->pdo->query('SELECT * FROM ads')->fetchAll();
        return array_map(fn($row) => Ad::createFromRow($row), $rows);
    }

    public function incrementShown(int $id): void
    {
        $stmt = $this->pdo->prepare('UPDATE ads SET shown = shown + 1 WHERE id = :id');
        $stmt->execute([':id' => $id]);
    }
}
```

> Примечание: поле `limit` переименовано в `limit_count` в БД, чтобы избежать конфликта с ключевым словом SQL.

