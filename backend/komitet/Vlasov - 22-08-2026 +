## src/Validator.php

```php
<?php

declare(strict_types=1);

namespace AdsApi;

use InvalidArgumentException;

class Validator
{
    public static function validateText(string $text): void
    {
        if (trim($text) === '') {
            throw new InvalidArgumentException('Text is required and cannot be empty.');
        }
        if (mb_strlen($text) > 255) {
            throw new InvalidArgumentException('Text must be no longer than 255 characters.');
        }
    }

    public static function validatePrice(mixed $price): float
    {
        if (!is_numeric($price)) {
            throw new InvalidArgumentException('Price must be numeric.');
        }
        $value = (float)$price;
        if ($value < 0) {
            throw new InvalidArgumentException('Price cannot be negative.');
        }
        return $value;
    }

    public static function validateLimit(mixed $limit): int
    {
        if (!is_numeric($limit)) {
            throw new InvalidArgumentException('Limit must be numeric.');
        }
        $value = (int)$limit;
        if ($value <= 0) {
            throw new InvalidArgumentException('Limit must be positive integer.');
        }
        return $value;
    }

    public static function validateBanner(string $banner): void
    {
        // Простая валидация URL
        if (!filter_var($banner, FILTER_VALIDATE_URL)) {
            throw new InvalidArgumentException('Invalid banner link.');
        }
    }
}
