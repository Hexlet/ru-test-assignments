<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Dotenv\Dotenv;
use App\Service\AdService;
use App\Repository\AdRepository;
use App\Controller\{
    CreateAdController,
    EditAdController,
    GetRelevantAdController
};

$dotenv = Dotenv::createImmutable(__DIR__ . '/../');
$dotenv->load();

// Инициализация зависимостей
$repository = new AdRepository();
$service = new AdService($repository);

$createController = new CreateAdController($service);
$editController = new EditAdController($service);
$relevantController = new GetRelevantAdController($service);

$uri = $_SERVER['REQUEST_URI'];
$method = $_SERVER['REQUEST_METHOD'];

// Примитивный роутинг для примера
if ($method === 'POST' && $uri === '/ads') {
    $createController->handle();
} elseif ($method === 'POST' && preg_match('#^/ads/(\d+)$#', $uri, $matches)) {
    $editController->handle((int)$matches[1]);
} elseif ($method === 'GET' && $uri === '/ads/relevant') {
    $relevantController->handle();
} else {
    http_response_code(404);
    echo json_encode(['message' => 'Not Found', 'code' => 404, 'data' => []]);
}
