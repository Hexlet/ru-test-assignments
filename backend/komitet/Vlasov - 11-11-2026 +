public function getRelevantAd(): Ad
{
    $pdo = $this->repository->getConnection();
    
    // Начинаем транзакцию для атомарности (чтобы два параллельных запроса не взяли одно и то же объявление)
    $pdo->beginTransaction();

    try {
        // 1. Ищем подходящее объявление
        $stmt = $pdo->prepare(
            'SELECT * FROM ads WHERE impressions < limit ORDER BY price DESC LIMIT 1 FOR UPDATE'
        );
        $stmt->execute();
        $data = $stmt->fetch(\PDO::FETCH_ASSOC);

        if (!$data) {
            $pdo->rollBack();
            throw new \RuntimeException('No relevant ads found');
        }

        // 2. Сразу бронируем показ
        $update = $pdo->prepare('UPDATE ads SET impressions = impressions + 1 WHERE id = :id');
        $update->execute(['id' => $data['id']]);

        $pdo->commit();

        return new Ad(
            (int)$data['id'],
            $data['text'],
            (int)$data['price'],
            (int)$data['limit'],
            $data['banner'],
            (int)$data['impressions'] + 1
        );
    } catch (\Throwable $e) {
        $pdo->rollBack();
        throw $e;
    }
}

