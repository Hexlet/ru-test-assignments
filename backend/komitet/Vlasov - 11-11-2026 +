    }

    public function handle(): JsonResponse
    {
        try {
            $ad = $this->adService->getRelevantAd();
            return new JsonResponse(200, 'OK', [
                'id' => $ad->getId(),
                'text' => $ad->getText(),
                'banner' => $ad->getBanner()
            ]);
