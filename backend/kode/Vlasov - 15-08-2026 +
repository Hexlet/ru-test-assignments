Задача №1: Проверка наличия связи между пользователями
Для этой задачи нам необходимо создать функцию check_relation, которая будет проверять существование связи между любыми двумя заданными пользователями в социальной сети. Мы будем использовать алгоритм поиска в ширину (BFS) для определения наличия пути между узлами графа.
Код решения
pythonКопировать
from collections import deque

def check_relation(net, first, second):
    # Создаем граф как словарь смежности
    graph = {}
    for a, b in net:
        if a not in graph:
            graph[a] = []
        if b not in graph:
            graph[b] = []
        graph[a].append(b)
        graph[b].append(a)
    
    # Инициализируем очередь для BFS и множество посещенных узлов
    queue = deque([first])
    visited = set()
    visited.add(first)
    
    while queue:
        current_node = queue.popleft()
        
        if current_node == second:
            return True
            
        for neighbor in graph.get(current_node, []):
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append(neighbor)
                
    return False


if __name__ == '__main__':
    net = (
        ("Ваня", "Лёша"), ("Лёша", "Катя"),
        ("Ваня", "Катя"), ("Вова", "Катя"),
        ("Лёша", "Лена"), ("Оля", "Петя"),
        ("Стёпа", "Оля"), ("Оля", "Настя"),
        ("Настя", "Дима"), ("Дима", "Маша")
    )

    assert check_relation(net, "Петя", "Стёпа") is True
    assert check_relation(net, "Маша", "Петя") is True
    assert check_relation(net, "Ваня", "Дима") is False
    assert check_relation(net, "Лёша", "Настя") is False
    assert check_relation(net, "Стёпа", "Маша") is True
    assert check_relation(net, "Лена", "Маша") is False
    assert check_relation(net, "Вова", "Лена") is True
Этот код создает граф социальных связей и использует BFS для поиска пути между двумя заданными пользователями.
