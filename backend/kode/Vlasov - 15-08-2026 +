Файл app.py
pythonКопировать
import os
from flask import Flask, request
import requests
from datetime import datetime, timedelta

app = Flask(__name__)
cache = {}
CACHE_DURATION = 30 * 60  # 30 minutes in seconds

@app.route('/weather')
def get_weather():
    city_name = request.args.get('city', None)
    if not city_name:
        return {"error": "City name is required"}, 400
    
    cached_data = cache.get(city_name)
    now = datetime.now()
    
    if cached_data and (now - cached_data['timestamp']).total_seconds() < CACHE_DURATION:
        return {
            'temperature': cached_data['data']['temp'],
            'pressure': cached_data['data']['pressure'],
            'wind_speed': cached_data['data']['wind_speed']
        }
    
    api_key = os.getenv("OPENWEATHER_API_KEY")
    url = f"http://api.openweathermap.org/data/2.5/weather?q={city_name}&appid={api_key}"
    
    response = requests.get(url)
    data = response.json()
    
    weather_info = {
        'temp': round(data['main']['temp'] - 273.15, 2),
        'pressure': int(data['main']['pressure'] * 0.750062),
        'wind_speed': data['wind']['speed']
    }
    
    cache[city_name] = {'timestamp': now, 'data': weather_info}
    
    return weather_info

if __name__ == "__main__":
    app.run(debug=True)
