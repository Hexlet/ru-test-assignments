python
Копировать
from fastapi import FastAPI, HTTPException, Depends
from sqlalchemy.orm import Session
from datetime import datetime
from typing import List

from . import models, schemas, database

app = FastAPI(title="Chat Server API")

# Создаем таблицы при старте, если их нет
models.Base.metadata.create_all(bind=database.engine)

def get_db():
    db = database.SessionLocal()
    try:
        yield db
    finally:
        db.close()

@app.post("/users/add", response_model=schemas.User)
def add_user(user: schemas.UserCreate, db: Session = Depends(get_db)):
    db_user = db.query(models.User).filter(models.User.username == user.username).first()
    if db_user:
        raise HTTPException(status_code=400, detail="Username already exists")
    
    db_user = models.User(username=user.username)
    db.add(db_user)
    db.commit()
    db.refresh(db_user)
    return db_user

@app.post("/chats/add", response_model=schemas.Chat)
def add_chat(chat: schemas.ChatCreate, db: Session = Depends(get_db)):
    # Проверяем, что все пользователи существуют
    db_users = db.query(models.User).filter(models.User.id.in_(chat.users)).all()
    if len(db_users) != len(chat.users):
        raise HTTPException(status_code=404, detail="One or more users not found")
    
    if db.query(models.Chat).filter(models.Chat.name == chat.name).first():
        raise HTTPException(status_code=400, detail="Chat name already exists")

    db_chat = models.Chat(name=chat.name)
    db_chat.users = db_users
    db.add(db_chat)
    db.commit()
    db.refresh(db_chat)
    return db_chat

@app.post("/messages/add", response_model=schemas.Message)
def add_message(message: schemas.MessageCreate, db: Session = Depends(get_db)):
    db_chat = db.query(models.Chat).filter(models.Chat.id == message.chat).first()
    db_author = db.query(models.User).filter(models.User.id == message.author).first()
    
    if not db_chat:
        raise HTTPException(status_code=404, detail="Chat not found")
    if not db_author:
        raise HTTPException(status_code=404, detail="Author not found")

    db_message = models.Message(
        chat_id=message.chat,
        author_id=message.author,
        text=message.text
    )
    db.add(db_message)
    db.commit()
    db.refresh(db_message)
    return db_message

@app.post("/chats/get", response_model=schemas.UserChatsResponse)
def get_user_chats(user_id: int, db: Session = Depends(get_db)):
    db_user = db.query(models.User).filter(models.User.id == user_id).first()
    if not db_user:
        raise HTTPException(status_code=404, detail="User not found")

    chats_data = []
    for chat in db_user.chats:
        last_msg = db.query(models.Message).filter(models.Message.chat_id == chat.id).order_by(models.Message.created_at.desc()).first()
        chats_data.append({
            "id": chat.id,
            "name": chat.name,
            "created_at": chat.created_at,
            "last_message_at": last_msg.created_at if last_msg else None
        })
    
    # Сортировка по последнему сообщению (от позднего к раннему)
    chats_data.sort(key=lambda x: x["last_message_at"] or datetime.min, reverse=True)
    
    return {"chats": chats_data}

@app.post("/messages/get", response_model=List[schemas.MessageListResponse])
def get_chat_messages(chat_id: int, db: Session = Depends(get_db)):
    db_chat = db.query(models.Chat).filter(models.Chat.id == chat_id).first()
    if not db_chat:
        raise HTTPException(status_code=404, detail="Chat not found")

    messages = db.query(models.Message).filter(models.Message.chat_id == chat_id).order_by(models.Message.created_at.asc()).all()
    return messages

