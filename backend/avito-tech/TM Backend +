version: '3.8'
services:
  db:
    image: postgres:16
    container_name: stats_db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: stats
    ports:
      - "5432:5432"
    volumes:
      - pg_data:/var/lib/postgresql/data
      - ./migrations:/docker-entrypoint-initdb.d

  app:
    build: .
    container_name: stat_service_app
    depends_on:
      - db
    ports:
      - "8080:8080"

volumes:
  pg_data:
