Файл internal/api/handlers.go:
goКопировать
package api

import (
    "encoding/json"
    "net/http"
    "stat-service/internal/storage"
)

func SaveStatHandler(s *storage.Storage) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req SaveStatsRequest
        if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
            http.Error(w, "Invalid JSON", http.StatusBadRequest)
            return
        }
        if err := req.Validate(); err != nil {
            http.Error(w, err.Error(), http.StatusBadRequest)
            return
        }

        costCents := 0
        if req.Cost != nil {
            costCents = int(*req.Cost * 100)
        }

        if err := s.SaveStat(r.Context(), req.Date, getOrZero(req.Views), getOrZero(req.Clicks), costCents); err != nil {
            http.Error(w, "DB error", http.StatusInternalServerError)
            return
        }
        w.WriteHeader(http.StatusCreated)
    }
}

func ShowStatsHandler(s *storage.Storage) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req ShowStatsRequest
        if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
            http.Error(w, "Invalid JSON", http.StatusBadRequest)
            return
        }
        if err := req.Validate(); err != nil {
            http.Error(w, err.Error(), http.StatusBadRequest)
            return
        }

        data, err := s.GetStats(r.Context(), req.From, req.To)
        if err != nil {
            http.Error(w, "DB error", http.StatusInternalServerError)
            return
        }

        resp := make([]StatResponse, len(data))
        for i, stat := range data {
            resp[i] = StatResponse{
                Date:   stat.Date.Format("2006-01-02"),
                Views:  stat.Views,
                Clicks: stat.Clicks,
                Cost:   float64(stat.CostCents) / 100,
            }
            if resp[i].Clicks > 0 {
                resp[i].CPC = resp[i].Cost / float64(resp[i].Clicks)
            }
            if resp[i].Views > 0 {
                resp[i].CPM = (resp[i].Cost / float64(resp[i].Views)) * 1000
            }
        }
        json.NewEncoder(w).Encode(resp)
    }
}

func ResetStatsHandler(s *storage.Storage) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        if err := s.ResetStats(r.Context()); err != nil {
            http.Error(w, "DB error", http.StatusInternalServerError)
            return
        }
        w.WriteHeader(http.StatusNoContent)
    }
}

func getOrZero(ptr *int) int {
    if ptr == nil {
        return 0
    }
    return *ptr
}
