goКопировать
package api

import (
    "errors"
    "regexp"
    "time"
)

// SaveStatsRequest — тело запроса на сохранение
type SaveStatsRequest struct {
    Date   string   `json:"date"`
    Views  *int     `json:"views,omitempty"`
    Clicks *int     `json:"clicks,omitempty"`
    Cost   *float64 `json:"cost,omitempty"`
}

func (r *SaveStatsRequest) Validate() error {
    if r.Date == "" {
        return errors.New("field 'date' is required")
    }
    if _, err := time.Parse("2006-01-02", r.Date); err != nil {
        return errors.New("field 'date' must be in format YYYY-MM-DD")
    }
    if r.Views != nil && *r.Views < 0 {
        return errors.New("field 'views' cannot be negative")
    }
    if r.Clicks != nil && *r.Clicks < 0 {
        return errors.New("field 'clicks' cannot be negative")
    }
    if r.Cost != nil {
        if *r.Cost < 0 {
            return errors.New("field 'cost' cannot be negative")
        }
        // Проверка на 2 знака после запятой
        re := regexp.MustCompile(`^\d+(\.\d{1,2})?$`)
        if !re.MatchString(formatCost(*r.Cost)) {
            return errors.New("field 'cost' must have no more than 2 decimal places")
        }
    }
    return nil
}

// ShowStatsRequest — тело запроса на получение статистики
type ShowStatsRequest struct {
    From string `json:"from"`
    To   string `json:"to"`
}

func (r *ShowStatsRequest) Validate() error {
    if r.From == "" || r.To == "" {
        return errors.New("fields 'from' and 'to' are required")
    }
    from, err1 := time.Parse("2006-01-02", r.From)
    to, err2 := time.Parse("2006-01-02", r.To)
    if err1 != nil || err2 != nil {
        return errors.New("fields 'from' and 'to' must be in format YYYY-MM-DD")
    }
    if from.After(to) {
        return errors.New("'from' date cannot be after 'to' date")
    }
    return nil
}

func formatCost(f float64) string {
    return strconv.FormatFloat(f, 'f', -1, 64)
}

// Модели для ответа
type StatResponse struct {
    Date  string  `json:"date"`
    Views int     `json:"views"`
    Clicks int    `json:"clicks"`
    Cost  float64 `json:"cost"`
    CPC   float64 `json:"cpc,omitempty"`
    CPM   float64 `json:"cpm,omitempty"`
}
