goКопировать
package storage

import (
    "context"
    "stat-service/internal/api"
)

type Storage struct {
    db *sqlx.DB
}

func NewStorage(db *sqlx.DB) *Storage {
    return &Storage{db: db}
}

// SaveStat агрегирует данные по дате
func (s *Storage) SaveStat(ctx context.Context, date string, views, clicks int, costCents int) error {
    // Используем конструкцию UPSERT (ON CONFLICT)
    query := `
        INSERT INTO stats (date, views, clicks, cost_cents)
        VALUES ($1, $2, $3, $4)
        ON CONFLICT (date) DO UPDATE SET
            views = stats.views + EXCLUDED.views,
            clicks = stats.clicks + EXCLUDED.clicks,
            cost_cents = stats.cost_cents + EXCLUDED.cost_cents;
    `
    _, err := s.db.ExecContext(ctx, query, date, views, clicks, costCents)
    return err
}

// GetStats возвращает данные за период
func (s *Storage) GetStats(ctx context.Context, from, to string) ([]models.Stat, error) {
    var stats []models.Stat
    query := `SELECT date, views, clicks, cost_cents FROM stats WHERE date BETWEEN $1 AND $2 ORDER BY date;`
    err := s.db.SelectContext(ctx, &stats, query, from, to)
    return stats, err
}

// ResetStats очищает таблицу
func (s *Storage) ResetStats(ctx context.Context) error {
    _, err := s.db.ExecContext(ctx, "TRUNCATE TABLE stats RESTART IDENTITY;")
    return err
}
