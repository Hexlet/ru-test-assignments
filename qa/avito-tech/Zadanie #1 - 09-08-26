package main

import (
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"os"
)

type Message struct {
	Channel string `json:"channel"`
	Text    string `json:"text"`
}

func main() {
	if len(os.Args) < 2 {
		log.Fatal("Usage: ./slack-sender <path-to-json>")
	}
	jsonPath := os.Args[1]

	data, err := os.ReadFile(jsonPath)
	if err != nil {
		log.Fatalf("Failed to read JSON file: %v", err)
	}

	var messages []Message
	if err := json.Unmarshal(data, &messages); err != nil {
		log.Fatalf("Failed to parse JSON: %v", err)
	}

	// Токен бота из переменной окружения SLACK_BOT_TOKEN
	token := os.Getenv("SLACK_BOT_TOKEN")
	if token == "" {
		log.Fatal("SLACK_BOT_TOKEN environment variable is not set")
	}

	client := &http.Client{}

	for i, m := range messages {
		channelID, err := getChannelID(client, token, m.Channel)
		if err != nil {
			log.Printf("[%d] Failed to resolve channel '%s': %v", i+1, m.Channel, err)
			continue
		}

		err = sendMessage(client, token, channelID, m.Text)
		if err != nil {
			log.Printf("[%d] Failed to send message to channel %s: %v", i+1, channelID, err)
		} else {
			fmt.Printf("[%d] Sent to %s: %s\n", i+1, channelID, m.Text)
		}
	}
}

// Получаем ID канала по имени (или по ID, если передано как ID)
func getChannelID(client *http.Client, token, name string) (string, error) {
	// Если name уже выглядит как ID канала (начинается с C/D), возвращаем как есть
	if len(name) >= 2 && (name[0] == 'C' || name[0] == 'D') {
		return name, nil
	}

	url := "https://slack.com/api/conversations.list"
	req, err := http.NewRequest("GET", url, nil)
	if err != nil {
		return "", err
	}
	req.Header.Set("Authorization", "Bearer "+token)

	resp, err := client.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return "", err
	}

	var listResp struct {
		OK    bool   `json:"ok"`
		Error string `json:"error"`
		Channels []struct {
			ID   string `json:"id"`
			Name string `json:"name"`
		} `json:"channels"`
	}

	if err := json.Unmarshal(body, &listResp); err != nil {
		return "", err
	}

	if !listResp.OK {
		return "", fmt.Errorf("Slack API error: %s", listResp.Error)
	}

	for _, c := range listResp.Channels {
		if c.Name == name {
			return c.ID, nil
		}
	}

	return "", fmt.Errorf("channel not found: %s", name)
}

func sendMessage(client *http.Client, token, channel, text string) error {
	url := "https://slack.com/api/chat.postMessage"
	req, err := http.NewRequest("POST", url, nil)
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Authorization", "Bearer "+token)

	payload := map[string]interface{}{
		"channel": channel,
		"text":    text,
	}

	jsonData, err := json.Marshal(payload)
	if err != nil {
		return err
	}

	req.Body = io.NopCloser(bytes.NewReader(jsonData)) // нужно добавить import "bytes"

	resp, err := client.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()

	var postResp struct {
		OK    bool   `json:"ok"`
		Error string `json:"error"`
	}

	if err := json.Unmarshal(resp.Body, &postResp); err != nil {
		return err
	}

	if !postResp.OK {
		return fmt.Errorf("chat.postMessage error: %s", postResp.Error)
	}
	return nil
}
