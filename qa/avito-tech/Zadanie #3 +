import pytest
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from pages.login_page import LoginPage
from pages.product_page import ProductPage
from pages.checkout_page import CheckoutPage

@pytest.fixture(scope="session")
def driver():
    from webdriver_manager.chrome import ChromeDriverManager
    from selenium import webdriver
    options = webdriver.ChromeOptions()
    options.add_argument("--start-maximized")  # Открыть браузер в полноэкранном режиме
    driver = webdriver.Chrome(executable_path=ChromeDriverManager().install(), options=options)
    yield driver
    driver.quit()

def test_empty_phone_field(driver):
    login_page = LoginPage(driver)
    product_page = ProductPage(driver)
    checkout_page = CheckoutPage(driver)

    # Авторизация (логин и пароль остаются пустыми)
    login_page.open("https://www.avito.ru/")
    login_page.click_login_button()
    login_page.enter_credentials("", "")  # Логин и пароль оставляют пустыми
    login_page.submit_login()

    # Переход на страницу личных вещей с доставкой
    product_page.open("https://www.avito.ru/sochi/lichnye_veschi?cd=1&d=1")
    product_page.select_first_delivery_product()

    # Оформление заказа с доставкой
    checkout_page.wait_for_checkout_form()
    assert checkout_page.get_phone_field_value() == "", "Поле телефона не пустое!"
