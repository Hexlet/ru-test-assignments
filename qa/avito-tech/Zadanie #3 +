from .base_page import BasePage

class ProductPage(BasePage):
    FIRST_DELIVERY_PRODUCT_LOCATOR = (By.CSS_SELECTOR, ".item-root[data-marker='delivery-item']")
    BUY_WITH_DELIVERY_BUTTON_LOCATOR = (By.XPATH, "//span[text()='Купить с доставкой']/parent::button")

    def select_first_delivery_product(self):
        delivery_item = WebDriverWait(self.driver, 10).until(EC.visibility_of_element_located(self.FIRST_DELIVERY_PRODUCT_LOCATOR))
        delivery_item.click()

    def buy_with_delivery(self):
        buy_button = WebDriverWait(self.driver, 10).until(EC.element_to_be_clickable(self.BUY_WITH_DELIVERY_BUTTON_LOCATOR))
        buy_button.click()
