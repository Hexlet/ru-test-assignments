pages/login_page.py
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from .base_page import BasePage

class LoginPage(BasePage):
    LOGIN_BUTTON_LOCATOR = (By.XPATH, "//button[@data-marker='login-button']")
    EMAIL_FIELD_LOCATOR = (By.ID, "email")
    PASSWORD_FIELD_LOCATOR = (By.ID, "password")
    SUBMIT_LOGIN_LOCATOR = (By.XPATH, "//button[@data-marker='submit-button']")

    def click_login_button(self):
        button = WebDriverWait(self.driver, 10).until(EC.element_to_be_clickable(self.LOGIN_BUTTON_LOCATOR))
        button.click()

    def enter_credentials(self, email, password):
        email_field = WebDriverWait(self.driver, 10).until(EC.presence_of_element_located(self.EMAIL_FIELD_LOCATOR))
        email_field.send_keys(email)
        password_field = WebDriverWait(self.driver, 10).until(EC.presence_of_element_located(self.PASSWORD_FIELD_LOCATOR))
        password_field.send_keys(password)

    def submit_login(self):
        submit_button = WebDriverWait(self.driver, 10).until(EC.element_to_be_clickable(self.SUBMIT_LOGIN_LOCATOR))
        submit_button.click()
