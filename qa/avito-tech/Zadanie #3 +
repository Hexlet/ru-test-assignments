from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from .base_page import BasePage

class CheckoutPage(BasePage):
    PHONE_FIELD_LOCATOR = (By.NAME, "phone")

    def wait_for_checkout_form(self):
        phone_field = WebDriverWait(self.driver, 10).until(EC.presence_of_element_located(self.PHONE_FIELD_LOCATOR))

    def get_phone_field_value(self):
        phone_field = self.driver.find_element(*self.PHONE_FIELD_LOCATOR)
        return phone_field.get_attribute("value")
