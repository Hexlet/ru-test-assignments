// Упрощенный пример класса Сотрудника
public class Employee {
    private UUID id;
    private String name;
    private List<Role> roles;
    private Map<DayOfWeek, List<WorkSlot>> schedule; // График доступности
    private int monthlyWorkedHours = 0;
    private double accumulatedSalary = 0.0;

    public boolean canWorkAt(DayOfWeek day, int hour) {
        if (schedule.get(day) == null) return false;
        return schedule.get(day).stream().anyMatch(slot -> slot.contains(hour));
    }

    public Optional<Role> findHighestPriorityRoleFor(Task task) {
        return roles.stream()
            .filter(r -> r.canPerform(task))
            .max(Comparator.comparingInt(Role::getPriority)
                .thenComparingDouble(Role::getEffectiveRate));
    }
    
    // Начисление зарплаты с учетом замечаний
    public void accrueSalary(boolean isWeekendMultiplier) {
        // 1. Находим фиксированную ставку (максимальную из возможных комбинаций)
        double fixedSalary = roles.stream()
            .filter(r -> !r.isHourly())
            .mapToDouble(Role::getBaseRate)
            .max().orElse(0.0);
            
        // 2. Считаем почасовую
        double hourlySalary = monthlyWorkedHours * getHourlyRate();
        if (isWeekendMultiplier) {
             hourlySalary *= 2; 
        }
        
        this.accumulatedSalary += fixedSalary + hourlySalary;
    }
}

// Логика распределения задач в Офисе
public void distributeTasks(List<Task> hourlyTasks) {
    for (Task task : hourlyTasks) {
        if (task.getDescription().equals("выполнить уборку в офисе")) {
            assignToOfficeStaff(task);
            continue;
        }
        
        // Ищем свободного сотрудника
        Employee assignee = findAvailableEmployee(task);
        
        if (assignee != null && assignee.hasMonthlyHoursLeft()) {
            assignee.assignTask(task);
        } else {
            // Если нет ресурса в офисе или выработан лимит - фриланс
            if (!task.getDescription().equals("выполнить уборку в офисе")) {
                freelancers.add(Freelancer.createForTask(task));
            }
        }
    }
}
