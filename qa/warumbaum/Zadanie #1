pages/main_page.py (Пример POM для поиска):
pythonКопировать
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

class YandexMainPage:
    SEARCH_FIELD = (By.ID, "text")
    SUGGEST_TABLE = (By.CSS_SELECTOR, ".mini-suggest__popup")
    
    def __init__(self, driver):
        self.driver = driver
        self.wait = WebDriverWait(driver, 10)

    def open(self):
        self.driver.get("https://yandex.ru")

    def search_for(self, query):
        field = self.wait.until(EC.visibility_of_element_located(self.SEARCH_FIELD))
        field.clear()
        field.send_keys(query)
        
        # Явно ждем появления таблицы подсказок
        self.wait.until(EC.visibility_of_element_located(self.SUGGEST_TABLE))
        
        field.submit()

    def is_first_link_tensor(self):
        # Ищем ссылку по тексту домена, так как позиция может меняться
        links = self.driver.find_elements(By.CSS_SELECTOR, "a.Link")
        for link in links[:5]: # Проверяем топ-5 ссылок
            if "tensor.ru" in link.get_attribute("href"):
                return True
        return False
tests/test_search.py (Бизнес-логика):
