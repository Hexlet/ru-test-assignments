import pytest
from pages.main_page import YandexMainPage

@pytest.mark.usefixtures("setup_driver") # Предполагаем, что фикстура setup_driver дает 'driver'
def test_yandex_search_flow(driver):
    page = YandexMainPage(driver)
    page.open()
    page.search_for("Тензор tensor.ru")
    
    assert page.is_first_link_tensor(), "Ссылка tensor.ru не найдена в топ-5 поисковой выдачи"
