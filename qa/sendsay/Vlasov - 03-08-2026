login.cy.js (сценарии входа)
js
ПереноситьСвернутьКопировать
/// <reference types="cypress" />

describe('Авторизация в Sendsay', () => {
  const baseUrl = 'https://app.sendsay.ru';

  beforeEach(() => {
    // Каждый тест начинается с чистой сессии
    cy.clearCookies();
    cy.visit(`${baseUrl}/signin`);
  });

  it('успешный вход с валидными учётными данными', () => {
    // Используем data-testid вместо классов/id, чтобы быть независимыми от вёрстки
    cy.get('[data-testid="login-input"]').clear().type('test-user@example.com');
    cy.get('[data-testid="password-input"]').clear().type('TestPass123!');
    cy.get('[data-testid="submit-login"]').click();

    // Ожидаем, что пользователь попал внутрь приложения (проверяем URL или наличие элемента)
    cy.url().should('not.contain', '/signin');
    cy.get('[data-testid="user-profile"]').should('be.visible'); // элемент, который виден только после входа
  });

  it('вход с невалидными данными (ошибка отображается)', () => {
    cy.get('[data-testid="login-input"]').clear().type('wrong-email');
    cy.get('[data-testid="password-input"]').clear().type('wrong-password');
    cy.get('[data-testid="submit-login"]').click();

    // Проверяем, что появляется сообщение об ошибке
    cy.get('[data-testid="auth-error-message"]').should('be.visible')
      .and('contain', 'неверный'); // подстройте текст под реальный интерфейс
  });

  it('корпоративный вход (заглушка сценария)', () => {
    // Если в интерфейсе есть переключатель «Корпоративный вход» — используем его
    cy.get('[data-testid="corporate-login-toggle"]').click();
    cy.get('[data-testid="sso-button"]').click();

    // Здесь логика зависит от реализации SSO в Sendsay.
    // В тестовом задании достаточно показать, что вы понимаете сценарий:
    // - переход на корпоративный поток
    // - ожидание редиректа или модального окна
    cy.location('pathname').should('contain', '/sso');
  });
});
Важно: В реальном проекте вместо [data-testid="..."] нужно использовать реальные атрибуты, которые есть в DOM Sendsay. Если их нет — в рамках тестового задания допустимо использовать более стабильные селекторы (например, по лейблу/тексту кнопки или по name). Но в комментариях обязательно укажите, что в продакшене лучше добавить data-testid.
