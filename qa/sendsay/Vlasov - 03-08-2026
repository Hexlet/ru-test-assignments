/// <reference types="cypress" />

describe('Создание и отправка email-рассылки', () => {
  const baseUrl = 'https://app.sendsay.ru';
  const campaignsUrl = `${baseUrl}/campaigns/issues`;

  beforeEach(() => {
    cy.clearCookies();
    // Для этого сценария нужен авторизованный пользователь
    cy.request({
      url: `${baseUrl}/signin`, // уточните реальный endpoint авторизации, если есть API
      method: 'POST',
      body: {
        email: 'test-user@example.com',
        password: 'TestPass123!'
      },
      failOnStatusCode: false
    }).then((resp) => {
      // Если Sendsay использует cookie-based auth, Cypress сохранит куки автоматически
      // После успешного логина переходим к кампаниям
      cy.visit(campaignsUrl);
    });
  });

  it('создание и отправка email-выпуска через визард', () => {
    // Переход в раздел рассылок (если нужно)
    cy.contains('Рассылки').click();
    cy.url().should('eq', campaignsUrl);

    // Создание нового выпуска
    cy.get('[data-testid="create-campaign-button"]').click();

    // Шаг 1: заполнение темы письма
    cy.get('[data-testid="subject-input"]').type('Тестовая рассылка для HH');

    // Шаг 2: выбор списка получателей (или создание нового)
    cy.get('[data-testid="recipients-select"]').select('test-list-1');

    // Шаг 3: контент письма (упрощённо: вставить шаблон)
    cy.get('[data-testid="editor-iframe']).then(($iframe) => {
      const $body = $iframe.contents().find('body');
      cy.wrap($body).type('Это тестовое письмо для e2e-теста.');
    });

    // Шаг 4: предпросмотр и подтверждение
    cy.get('[data-testid="preview-button"]').click();
    cy.get('[data-testid="confirm-send-button"]').click();

    // Финальное подтверждение отправки
    cy.get('[data-testid="final-send-confirm"]').click();

    // Проверка статуса: рассылка отправлена
    cy.contains('Рассылка успешно отправлена').should('be.visible');
  });

  it('попытка отправки без заполнения обязательных полей (валидация)', () => {
    cy.get('[data-testid="create-campaign-button"]').click();
    // Пропускаем заполнение темы (обязательное поле)
    cy.get('[data-testid="next-step-button"]').click();

    // Ожидается сообщение валидации
    cy.get('[data-testid="validation-error"]').should('be.visible');
  });
});
