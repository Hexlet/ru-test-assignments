Шаг 4. Store для управления состоянием (src/stores/servicesStore.js)
js
import { makeAutoObservable } from 'mobx';
import { getServices, getServiceById } from '../api';

class ServicesStore {
  services = [];
  service = null;
  loading = false;
  error = null;

  constructor() {
    makeAutoObservable(this);
  }

  // Загрузка списка услуг
  async fetchServices() {
    this.loading = true;
    this.error = null;
    try {
      const response = await getServices();
      this.services = response.data;
    } catch (err) {
      this.error = err.message || 'Не удалось загрузить список услуг';
    } finally {
      this.loading = false;
    }
  }

  // Загрузка деталей услуги
  async fetchServiceById(id) {
    this.loading = true;
    this.error = null;
    try {
      const response = await getServiceById(id);
      this.service = response.data;
    } catch (err) {
      this.error = err.message || 'Не удалось загрузить детали услуги';
    } finally {
      this.loading = false;
    }
  }

  // Сброс ошибки (для кнопки «Повторить запрос»)
  clearError() {
    this.error = null;
  }
}

const servicesStore = new ServicesStore();
export default servicesStore;
