Список услуг (src/components/ServicesList.jsx)
jsx
import { useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { observer } from 'mobx-react-lite';
import Loader from './Loader';
import ErrorBlock from './ErrorBlock';
import { servicesStore } from '../stores/servicesStore';

const ServicesList = () => {
  const navigate = useNavigate();

  useEffect(() => {
    servicesStore.fetchServices();
  }, []);

  if (servicesStore.loading && !servicesStore.services.length) {
    return <Loader />;
  }

  return (
    <div>
      <h1>Список услуг</h1>
      {servicesStore.error && (
        <ErrorBlock onRetry={() => servicesStore.fetchServices()} />
      )}
      <ul>
        {servicesStore.services.map((service) => (
          <li key={service.id}>
            <Link to={`/services/\${service.id}/details`}>
              {service.name || service.title || `Услуга \${service.id}`}
            </Link>
          </li>
        ))}
      </ul>
    </div>
  );
};

export default observer(ServicesList);
Детали услуги (src/components/ServiceDetails.jsx)
jsx
import { useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { observer } from 'mobx-react-lite';
import Loader from './Loader';
import ErrorBlock from './ErrorBlock';
import { servicesStore } from '../stores/servicesStore';

const ServiceDetails = () => {
  const { id } = useParams();
  const navigate = useNavigate();

  useEffect(() => {
    servicesStore.fetchServiceById(id);
  }, [id]);

  if (servicesStore.loading && !servicesStore.service) {
    return <Loader />;
  }

  if (servicesStore.error) {
    return (
      <ErrorBlock onRetry={() => servicesStore.fetchServiceById(id)} />
    );
  }

  const service = servicesStore.service;
  if (!service) {
    return <p>Услуга не найдена</p>;
  }

  return (
    <div>
      <h1>{service.name || service.title || `Услуга \${service.id}`}</h1>
      <p>{service.description || 'Нет описания'}</p>
      <button onClick={() => navigate(-1)}>Назад к списку</button>
    </div>
  );
};

export default observer(ServiceDetails);
