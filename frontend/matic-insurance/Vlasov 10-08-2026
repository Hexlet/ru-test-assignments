ПереноситьСвернутьКопировать
const CACHE_KEY = 'rick_and_morty_cache';

export interface CharacterCacheItem {
  id: number;
  data: any;
  timestamp: number; // для TTL (бонус)
}

export type CacheMap = Record<string, CharacterCacheItem>;

export function getCache(): CacheMap {
  const raw = localStorage.getItem(CACHE_KEY);
  return raw ? JSON.parse(raw) : {};
}

export function setCache(cache: CacheMap) {
  localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
}

export function addToCache(id: number, data: any, ttlMs?: number) {
  const cache = getCache();
  cache[String(id)] = { id, data, timestamp: Date.now() };
  setCache(cache);
}

export function getFromCache(id: number): CharacterCacheItem | undefined {
  const cache = getCache();
  return cache[String(id)];
}

export function clearCache() {
  localStorage.removeItem(CACHE_KEY);
}

export function removeFromCache(id: number) {
  const cache = getCache();
  delete cache[String(id)];
  setCache(cache);
}

// Бонус: TTL-очистка
export function cleanExpiredCache(ttlMs: number) {
  const now = Date.now();
  const cache = getCache();
  const updated: CacheMap = {};

  for (const [key, item] of Object.entries(cache)) {
    if (now - item.timestamp <= ttlMs) {
      updated[key] = item;
    }
  }

  if (Object.keys(cache).length !== Object.keys(updated).length) {
    setCache(updated);
  }
}
