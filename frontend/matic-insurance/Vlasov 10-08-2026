ПереноситьСвернутьКопировать
import { useState, useCallback } from 'react';
import { getFromCache, addToCache, cleanExpiredCache } from '../store/cache';

const TTL_MS = 5 * 60 * 1000; // 5 минут (бонус: TTL)

export const useRickAndMorty = () => {
  const [character, setCharacter] = useState<any>(null);
  const [isLoading, setIsLoading] = useState(false);

  const fetchCharacter = useCallback(async (id: number) => {
    // Бонус: очистка истёкших записей перед запросом
    cleanExpiredCache(TTL_MS);

    const cached = getFromCache(id);
    if (cached) {
      setCharacter(cached.data);
      return;
    }

    setIsLoading(true);
    try {
      const res = await fetch(`https://rickandmortyapi.com/api/character/${id}`);
      if (!res.ok) throw new Error('Not found');
      const data = await res.json();
      setCharacter(data);
      addToCache(id, data, TTL_MS);
    } catch (e) {
      // обработка ошибок (можно показать сообщение)
    } finally {
      setIsLoading(false);
    }
  }, []);

  const clearAllCache = () => {
    // можно добавить подтверждение
    localStorage.removeItem('rick_and_morty_cache');
  };

  return { character, isLoading, fetchCharacter, clearAllCache };
};
5. Мгновенный показ из кэша при вводе ID
Бонус: если в поле введён ID, который уже есть в кэше — сразу показываем персонажа (без клика). Это можно сделать через useEffect на изменение поля или через валидацию перед отправкой.
Пример простой логики:
ts
ПереноситьСвернутьКопировать
useEffect(() => {
  const id = Number(query);
  if (!isNaN(id) && id > 0) {
    const cached = getFromCache(id);
    if (cached) {
      setCharacter(cached.data);
    }
  }
}, [query]);
