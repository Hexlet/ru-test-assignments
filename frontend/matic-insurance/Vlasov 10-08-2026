import {
  getCache,
  setCache,
  addToCache,
  getFromCache,
  clearCache,
} from '../src/store/cache';

beforeEach(() => {
  localStorage.clear();
});

test('добавляет и получает из кэша', () => {
  addToCache(1, { id: 1, name: 'Rick' });
