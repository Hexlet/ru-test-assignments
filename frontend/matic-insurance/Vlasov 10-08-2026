Реализация ключевых требований
1. Поиск персонажа по ID
Пользователь вводит число → клик «Search» → запрос к API. Пока запрос идёт — блокируем кнопку и поле.
Компонент SearchForm.tsx:
tsx
ПереноситьСвернутьКопировать
import { useState } from 'react';
import { useRickAndMorty } from '../hooks/useRickAndMorty';

export const SearchForm = ({ onSearch }: { onSearch: (id: number) => void }) => {
  const [query, setQuery] = useState('');
  const { isLoading } = useRickAndMorty(); // или передаём isLoading из родителя

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const id = Number(query.trim());
    if (!Number.isInteger(id) || id <= 0) return;
    onSearch(id);
  };

  return (
    <form onSubmit={handleSubmit}>
      <input
        type="number"
        value={query}
        onChange={(e) => setQuery(e.target.value)}
        disabled={isLoading}
        placeholder="Enter character ID"
      />
      <button type="submit" disabled={isLoading || !query.trim()}>
        {isLoading ? 'Loading...' : 'Search'}
      </button>
    </form>
  );
};
2. Кэш в памяти браузера (localStorage)
Логика кэширования должна быть вынесена в отдельный модуль, чтобы её можно было тестировать изолированно.
