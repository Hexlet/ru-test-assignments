4. State-менеджер (Pinia) — пример одного стора
Остальные два строятся по аналогии.
typescriptКопировать
// src/stores/warehouse.ts
import { defineStore } from 'pinia';
import { ref, computed } from 'vue';
import { useDealsStore } from './deals';
import { useFavoritesStore } from './favorites';
import { MOCK_OFFERS } from '@/data/mockData';
import { Offer } from '@/types';

export const useWarehouseStore = defineStore('warehouse', () => {
  const offers = ref<Offer[]>(MOCK_OFFERS);
  const searchQuery = ref('');
  const filterType = ref<'all' | 'auction' | 'direct'>('all');

  const filteredOffers = computed(() => {
    return offers.value.filter(offer => {
      const matchesSearch = offer.title.toLowerCase().includes(searchQuery.value.toLowerCase());
      const matchesFilter = 
        filterType.value === 'all' || 
        offer.type === filterType.value;
      return matchesSearch && matchesFilter;
    });
  });

  const dealsStore = useDealsStore();
  const favoritesStore = useFavoritesStore();

  function addToDeals(id: string) {
    const item = offers.value.find(o => o.id === id);
    if (item) dealsStore.addDeal(item);
  }

  function addToFavorites(id: string) {
    const item = offers.value.find(o => o.id === id);
    if (item) favoritesStore.addFavorite(item);
  }

  return { 
    filteredOffers, 
    searchQuery, 
    filterType, 
    addToDeals, 
    addToFavorites 
  };
});
