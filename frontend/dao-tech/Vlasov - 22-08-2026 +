// ... внутри файла после редукторов
export const selectFilteredTodos = (state: RootState): Todo[] => {
  switch (state.todos.filter) {
    case 'completed':
      return state.todos.items.filter(t => t.completed);
    case 'active':
      return state.todos.items.filter(t => !t.completed);
    default:
      return state.todos.items;
  }
};

export const selectCounts = (state: RootState) => ({
  completed: state.todos.items.filter(t => t.completed).length,
  active: state.todos.items.filter(t => !t.completed).length
});

