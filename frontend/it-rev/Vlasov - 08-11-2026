import { render, screen, fireEvent } from '@testing-library/react';
import { Provider } from 'react-redux';
import { configureStore } from '@reduxjs/toolkit';
import walksReducer from '../walksSlice';
import WalksTable from './WalksTable';

test('allows user to delete a row', () => {
  const store = configureStore({ reducer: { walks: walksReducer } });
  render(<Provider store={store}><WalksTable /></Provider>);
  
  const deleteButtons = screen.getAllByText('Удал.');
  fireEvent.click(deleteButtons[0]);
  
  expect(screen.queryAllByText('Удал.')).toHaveLength(deleteButtons.length - 1);
});
9. Адаптивность и кроссбраузерность
Адаптивность: Таблица оборачивается в контейнер с горизонтальным скроллом (overflow-x: auto) на мобильных устройствах. На десктопах включается sticky для заголовка таблицы. Используются относительные единицы (rem, %).
Кроссбраузерность: Современные версии Chrome, Firefox, Safari, Edge полностью поддерживают используемый стек (ES6+, CSS Grid/Flexbox, Shadow DOM от Styled Components). Полифиллы не требуются, если CRA сконфигурирован под дефолтный браузерслист (browserslist).
