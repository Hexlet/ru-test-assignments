import reducer, { deleteWalk } from './walksSlice';
import walksData from '../../api/walks';

describe('walksSlice', () => {
  it('should remove a walk by id', () => {
    const testWalk = { id: 'test-id', date: '2025-01-01', distance: 1, duration: 10 };
    const state = reducer({ items: [testWalk, ...walksData], status: 'succeeded', error: null, sortBy: 'date', order: 'desc', editingId: null }, deleteWalk('test-id'));
    
    expect(state.items).toHaveLength(walksData.length);
    expect(state.items.some(w => w.id === 'test-id')).toBe(false);
  });
});

