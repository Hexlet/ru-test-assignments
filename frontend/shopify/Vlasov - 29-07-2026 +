import { useState } from "react";
import { sendToOpenAI } from "../utils/openai";

interface PromptFormProps {
  onAdd: (prompt: string, response: string) => void;
}

export function PromptForm({ onAdd }: PromptFormProps) {
  const [prompt, setPrompt] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!prompt.trim()) return;
    setIsLoading(true);
    setError(null);

    try {
      const response = await sendToOpenAI(prompt);
      onAdd(prompt, response);
      setPrompt("");
    } catch (err) {
      setError((err as Error).message);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <form onSubmit={handleSubmit} aria-labelledby="prompt-form-heading">
      <h2 id="prompt-form-heading" className="visually-hidden">
        Отправить запрос к GPT
      </h2>

      <div>
        <label htmlFor="prompt-input">Ваш запрос</label>
        <textarea
          id="prompt-input"
          value={prompt}
          onChange={(e) => setPrompt(e.target.value)}
          rows={3}
          aria-describedby={error ? "error-message" : undefined}
          disabled={isLoading}
        />
      </div>

      {error && (
        <div id="error-message" role="alert" style={{ color: "#b00020", marginTop: "8px" }}>
          {error}
        </div>
      )}

      <button type="submit" disabled={isLoading || !prompt.trim()}>
        {isLoading ? "Отправляю…" : "Отправить"}
      </button>
    </form>
  );
}
visually-hidden можно реализовать через CSS или просто убрать, если не хотите добавлять стили.
