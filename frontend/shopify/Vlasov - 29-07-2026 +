App.tsx — сборка всего вместе + сохранение в localStorage
tsx
ПереноситьСвернутьКопировать
import { useState, useEffect } from "react";
import { PromptForm } from "./components/PromptForm";
import { ResponseList } from "./components/ResponseList";

interface StoredResponse {
  prompt: string;
  response: string;
}

function App() {
  const [responses, setResponses] = useState<StoredResponse[]>([]);

  useEffect(() => {
    // Восстановление после перезагрузки страницы
    const saved = localStorage.getItem("openai-responses");
    if (saved) {
      setResponses(JSON.parse(saved));
    }
  }, []);

  useEffect(() => {
    // Сохранение при каждом изменении
    localStorage.setItem("openai-responses", JSON.stringify(responses));
  }, [responses]);

  const addResponse = (prompt: string, response: string) => {
    setResponses((prev) => [
      { prompt, response },
      ...prev,
    ]);
  };

  return (
    <main>
      <h1>Забавы с GPT-3</h1>
      <PromptForm onAdd={addResponse} />
      <hr />
      <h2>История запросов и ответов</h2>
      <ResponseList responses={responses} />
    </main>
  );
}

export default App;
Это закрывает «Extra»: сохранение ответов при перезагрузке страницы.
