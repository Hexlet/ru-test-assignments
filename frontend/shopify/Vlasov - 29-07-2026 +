import { ResponseItem } from "./ResponseItem";

interface Response {
  prompt: string;
  response: string;
}

interface ResponseListProps {
  responses: Response[];
}

export function ResponseList({ responses }: ResponseListProps) {
  if (responses.length === 0) {
    return <p>Пока нет ответов.</p>;
  }

  // Новые сверху: массив уже хранится в порядке добавления, просто отображаем в обратном
  return (
    <ol reversed>
      {responses.map((r, idx) => (
        <li key={idx} style={{ listStyle: "none", marginBottom: "16px" }}>
          <ResponseItem prompt={r.prompt} response={r.response} />
        </li>
      ))}
    </ol>
  );
}
reversed у <ol> даёт сортировку «от нового к старому» без лишних вычислений.
