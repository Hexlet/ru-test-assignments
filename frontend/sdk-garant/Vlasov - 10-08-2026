src/view/main/DocsController.js (логика таблицы)
javascriptКопировать
Ext.define('MyApp.view.main.DocsController', {
    extend: 'Ext.app.ViewController',
    alias: 'controller.docs',
    
    init: function(view) {
        this.grid = view.down('grid');
    },
    
    onDocsButtonClick: function() {
        const tabPanel = this.lookupReference('mainTabPanel'); // Доступ через refs во Viewport
        let tab = tabPanel.child('#docsTab');
        if (!tab) {
            tab = tabPanel.add({
                xtype: 'docsgrid',
                title: 'Документы',
                itemId: 'docsTab',
                closable: true
            });
        }
        tabPanel.setActiveTab(tab);
    },
    
    onItemDblClick: function(grid, record) {
        const win = Ext.create('MyApp.view.document.DocEditWindow', {
            viewModel: {
                data: {
                    theRecord: record
                }
            }
        });
        win.show();
    }
});
