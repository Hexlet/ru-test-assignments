6. Окно редактирования и логика сохранения
src/view/document/DocEditWindow.js
javascriptКопировать
Ext.define('MyApp.view.document.DocEditWindow', {
    extend: 'Ext.window.Window',
    xtype: 'doceditwindow',
    
    title: 'Редактирование документа ID: {theRecord.id}',
    width: 400,
    
    viewModel: {
        formulas: {
            windowTitle: function(get) {
                return 'Редактирование документа ID: ' + get('theRecord.id');
            }
        }
    },
    
    bind: {
        title: '{windowTitle}'
    },
    
    items: [{
        xtype: 'form',
        bodyPadding: 10,
        reference: 'docForm',
        defaults: { anchor: '100%', labelWidth: 120 },
        
        items: [
            { xtype: 'displayfield', name: 'id', fieldLabel: 'ID', bind: '{theRecord.id}' },
            { xtype: 'textfield', name: 'name', fieldLabel: 'Название', bind: '{theRecord.name}', allowBlank: false },
            { xtype: 'checkboxfield', name: 'signed', fieldLabel: 'Подписать документ', bind: '{theRecord.signed}' }
        ]
    }],
    
    buttons: [{
        text: 'Сохранить',
        handler: 'onSave'
    }],
    
    controller: {
        onSave: function() {
            const form = this.lookupReference('docForm');
            const record = this.getViewModel().get('theRecord');
            
            if (form.isValid()) {
                form.updateRecord(record); // Запись данных из формы в модель
                
                // Логика запроса на сервер (AJAX)
                Ext.Ajax.request({
                    url: '/api/documents/save/' + record.get('id'),
                    method: 'POST',
                    jsonData: record.getData(),
                    success: function(response) {
                        Ext.Msg.alert('Успех', 'Данные сохранены');
                        this.getView().close();
                        this.lookup('docsgrid').getStore().reload(); // Обновление грида
                    },
                    failure: function() {
                        Ext.Msg.alert('Ошибка', 'Не удалось сохранить данные');
                    },
                    scope: this
                });
            }
        }
    }
});
Реализация дополнительных заданий:
1.	Проброс логина: Выполнено через вызов parentVm.set('currentUser', ...) в AuthViewModel и привязку {currentUser} в MainViewModel и UserPanel.
2.	Фильтры: Реализованы через стандартный плагин Ext.grid.filters.Filters прямо в конфигурации колонок и свойств панели.
3.	Сохранение товара: Реализовано в методе onSave контроллера окна через Ext.Ajax.request. При создании нового документа логика идентична, но URL меняется на /api/documents/create, а форма открывается пустой (создается новая пустая запись модели).
4.	Красная тема: Частично реализована через CSS-перезаписи переменных темы. Для полноценной смены темы рекомендуется использовать Sencha Themer.
5.	Альтернативное открытие (табы): Реализовано в методе onDocsButtonClick. При нажатии на кнопку меню проверяется наличие таба по itemId. Если его нет — создается новый инстанс docsgrid внутри tabpanel. Это позволяет открывать несколько независимых таблиц документов одновременно.

