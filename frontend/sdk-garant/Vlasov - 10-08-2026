src/viewModel/AuthViewModel.js
javascriptКопировать
Ext.define('MyApp.viewModel.AuthViewModel', {
    extend: 'Ext.app.ViewModel',
    alias: 'viewmodel.auth',
    
    formulas: {
        isValidCredentials: function(get) {
            const user = get('username');
            const pass = get('password');
            return user === 'admin' && pass === 'adm123';
        }
    },
    
    onLoginClick: function() {
        const vm = this;
        if (vm.get('isValidCredentials')) {
            // Пробрасываем логин в родительский (глобальный) ViewModel
            const parentVm = this.getParent();
            parentVm.set('currentUser', vm.get('username'));
            
            // Закрываем окно и создаем основное приложение
            this.getView().close();
            Ext.create({
                xtype: 'app-mainviewport'
            });
        } else {
            Ext.Msg.alert('Ошибка', 'Неверный логин или пароль');
        }
    }
});
