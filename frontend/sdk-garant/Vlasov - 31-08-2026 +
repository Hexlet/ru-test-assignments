javascriptКопировать
Ext.define('SDKGarantApp.controller.AuthController', {
    extend: 'Ext.app.Controller',
    
    routes: {
        'login': 'showLogin'
    },

    showLogin: function() {
        if (!this.loginWin) {
            this.loginWin = Ext.create('SDKGarantApp.view.main.LoginWindow');
        }
        this.loginWin.show();
    },

    onLoginClick: function(btn) {
        var form = btn.up('form').getForm();
        if (form.isValid()) {
            var values = form.getValues();
            // Жесткая проверка согласно ТЗ
            if (values.username === 'admin' && values.password === 'adm123') {
                localStorage.setItem('isLoggedIn', true);
                localStorage.setItem('currentUser', values.username); // Для доп. задания
                this.loginWin.destroy();
                this.redirectTo('documents');
            } else {
                Ext.Msg.alert('Ошибка', 'Неверный логин или пароль');
            }
        }
    }
});
