app/controller/MainController.js
javascriptКопировать
Ext.define('SDKGarantApp.controller.MainController', {
    extend: 'Ext.app.Controller',
    
    routes: {
        'documents': 'showMain'
    },

    refs: [{
        ref: 'mainTabPanel',
        selector: 'tabpanel[reference=mainTabPanel]'
    }],

    control: {
        'docgrid': {
            itemdblclick: 'onDocDblClick'
        }
    },

    showMain: function() {
        Ext.create('SDKGarantApp.view.main.MainViewport');
    },

    openDocsTab: function() {
        var tabPanel = this.getMainTabPanel();
        var docsGrid = tabPanel.down('docgrid');
        
        if (!docsGrid) {
            docsGrid = tabPanel.add({
                xtype: 'docgrid'
            });
        }
        tabPanel.setActiveTab(docsGrid);
    },

    onDocDblClick: function(grid, record) {
        var win = Ext.create('SDKGarantApp.view.main.DocFormWindow', {
            title: 'Редактирование документа #' + record.get('id')
        });
        win.down('form').loadRecord(record);
        win.show();
    },

    onSaveDoc: function(btn) {
        var win = btn.up('window');
        var form = win.down('form').getForm();
        var record = form.getRecord();
        
        if (form.isValid()) {
            form.updateRecord();
            
            // Дополнительное задание: запрос на сервер
            // record.save({
            //     success: function(rec, operation) {
            //         Ext.Msg.alert('Успех', 'Данные сохранены');
            //         win.close();
            //     }
            // });
            
            Ext.Msg.alert('Успех', 'Изменения применены локально.');
            win.close();
        }
    },

    // Фильтрация
    onNameFilterChange: function(field) {
        var value = field.getValue().toLowerCase();
        var grid = field.up('grid');
        var store = grid.getStore();
        
        store.clearFilter(true);
        if (value) {
            store.filterBy(function(record){
                return record.get('name').toLowerCase().indexOf(value) !== -1;
            });
        }
    },

    onSignedFilterToggle: function(checkbox, newVal) {
        var grid = checkbox.up('grid');
        var store = grid.getStore();
        
        store.clearFilter(true);
        if (newVal) {
            store.filter('signed', true);
        }
    }
});
