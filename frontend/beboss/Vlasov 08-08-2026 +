(function($) {
    $.fn.trackCoords = function(options) {
        const settings = $.extend({
            checkInterval: 30,      // мс — частота сбора координат
            sendInterval: 3000,     // мс — частота отправки данных
            url: '/save.php'        // URL для отправки
        }, options);

        return this.each(function() {
            const $element = $(this);
            const elementOffset = $element.offset();
            let points = [];
            let lastTime = null;
            let checkTimer = null;
            let sendTimer = null;

            // Функция сбора точки
            const collectPoint = () => {
                const now = Date.now();
                // Если это первая точка — просто сохраняем время, длительность пока не известна
                if (lastTime === null) {
                    lastTime = now;
                    return;
                }

                const duration = now - lastTime;
                lastTime = now;

                points.push({
                    x: event ? event.pageX - elementOffset.left : 0,
                    y: event ? event.pageY - elementOffset.top : 0,
                    time: duration // время, которое курсор «провел» до этой точки (мс)
                });
            };

            // Обработчик движения мыши
            const onMouseMove = (e) => {
                // Обновляем смещение при изменении положения элемента (на случай рефлоу/анимаций)
                elementOffset = $element.offset();
                collectPoint();
            };

            // Отправка данных на сервер
            const sendData = () => {
                if (points.length === 0) return;

                $.ajax({
                    url: settings.url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(points),
                    success: () => {
                        // После успешной отправки очищаем накопленные данные
                        points = [];
                    },
                    error: (xhr, status, error) => {
                        console.error('Ошибка отправки данных:', error);
                        // В случае ошибки можно решить: сохранять данные или сбрасывать.
                        // Здесь — сбрасываем, чтобы не накапливать бесконечно.
                        points = [];
                    }
                });
            };

            // Запуск таймеров
            checkTimer = setInterval(() => {
                // Для корректного расчёта длительности нужно хотя бы одно событие мыши.
                // Но чтобы не зависеть строго от события, можно эмулировать «последнюю точку»
                // по времени, если мышь давно не двигалась. Однако по ТЗ — сбор по положению курсора.
                // Поэтому collectPoint() вызывается только из onMouseMove.
                // Здесь можно добавить логику «финальной точки» при отсутствии движения,
                // но в текущей реализации мы полагаемся на события движения.
            }, settings.checkInterval);

            sendTimer = setInterval(sendData, settings.sendInterval);

            // Привязка событий
            $element.on('mousemove', onMouseMove);

            // Очистка при уничтожении элемента (опционально)
            $element.on('remove', () => {
                clearInterval(checkTimer);
                clearInterval(sendTimer);
                $element.off('mousemove');
                $element.off('remove');
            });
        });
    };
})(jQuery);
