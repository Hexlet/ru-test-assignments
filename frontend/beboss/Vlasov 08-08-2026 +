<?php
$host = 'localhost';
$db   = 'test_db';
$user = 'root';
$pass = '';
$charset = 'utf8mb4';

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
];

try {
    $pdo = new PDO($dsn, $user, $pass, $options);
} catch (\PDOException $e) {
    die('Подключение к БД не удалось: ' . $e->getMessage());
}

// Получаем текущую группу (если не задана — null)
$currentGroupId = isset($_GET['group']) ? (int)$_GET['group'] : null;

// ---------------------------------------------------------
// 1. Получаем все группы и строим дерево
// ---------------------------------------------------------
$groupsStmt = $pdo->query("SELECT id, id_parent, name, total_products FROM groups");
$allGroups = $groupsStmt->fetchAll();

// Строим дерево: $tree[$parentId] = [список детей]
$tree = [];
foreach ($allGroups as $g) {
    $parentId = $g['id_parent'] ?? 0;
    if (!isset($tree[$parentId])) {
        $tree[$parentId] = [];
    }
    $tree[$parentId][] = $g;
}

// ---------------------------------------------------------
// 2. Функция для рекурсивного вывода списка групп
// ---------------------------------------------------------
function renderGroupsList(array $groups, int $parentId, ?int $currentGroupId, string $baseUrl): string {
    if (empty($groups)) {
        return '';
    }

    $html = '<ul>';
    foreach ($groups as $g) {
        // Ссылка: если это корневая группа и мы не внутри неё — ссылка на неё.
        // Если мы уже внутри этой группы — можно сделать ссылку на неё же или убрать ссылку.
        // По условию: название — ссылка, которая вызывает тот же скрипт с group=id.
        $link = $baseUrl . '?group=' . $g['id'];
        $nameHtml = '<a href="' . htmlspecialchars($link, ENT_QUOTES, 'UTF-8') . '">'
                  . htmlspecialchars($g['name'], ENT_QUOTES, 'UTF-8')
                  . '</a>';

        // Количество товаров: берём из total_products (заранее посчитано)
        $count = (int)($g['total_products'] ?? 0);
        $html .= '<li>' . $nameHtml . ' (' . $count . ')</li>';

        // Рекурсивно выводим подгруппы
        global $tree;
        if (isset($tree[$g['id']])) {
            $html .= renderGroupsList($tree[$g['id']], $g['id'], $currentGroupId, $baseUrl);
        }
    }
    $html .= '</ul>';

    return $html;
}

// ---------------------------------------------------------
// 3. Получаем товары для текущей группы и всех её подгрупп
// ---------------------------------------------------------
function getGroupIdsRecursive(int $groupId, array $tree): array {
    $ids = [$groupId];
    if (isset($tree[$groupId])) {
        foreach ($tree[$groupId] as $child) {
            $ids = array_merge($ids, getGroupIdsRecursive($child['id'], $tree));
        }
    }
    return $ids;
}

$productIds = [];
if ($currentGroupId !== null) {
    // Собираем все ID групп в поддереве
    $groupIds = getGroupIdsRecursive($currentGroupId, $tree);
    $placeholders = implode(',', array_fill(0, count($groupIds), '?'));
    $sql = "SELECT id, name FROM products WHERE id_group IN ($placeholders)";
    $stmt = $pdo->prepare($sql);
    $stmt->execute($groupIds);
    $products = $stmt->fetchAll();
} else {
    // Если группа не выбрана — выводим все товары
    $stmt = $pdo->query("SELECT id, name FROM products");
    $products = $stmt->fetchAll();
}

