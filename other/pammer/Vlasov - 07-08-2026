Задание 5*

Реализуйте иерархию классов роботов, демонстрируя основные принципы ООП.

Базовые классы и интерфейсы

Создадим базовые абстракции:

java
Копировать
abstract class Robot {
    protected EnergySource energySource;

    public abstract void performAction();

    public void refuel(EnergySource source) {
        this.energySource = source;
    }
}

interface Actionable {
    void doAction();
}

enum EnergyType { ATOMIC, INTERNAL_COMBUSTION, ELECTRIC }

abstract class EnergySource {
    protected EnergyType type;

    public abstract void provideEnergy(Robot robot);
}
Конкретные реализации роботов и источников энергии

Боевой робот:

java
Копировать
class CombatRobot extends Robot implements Actionable {
    private Weapon weapon;

    public CombatRobot(EnergySource energySource, Weapon weapon) {
        super();
        this.weapon = weapon;
        this.refuel(energySource);
    }

    @Override
    public void performAction() {
        System.out.println("Боевой робот стреляет.");
        weapon.shoot();
    }
}

class AtomicEnergySource extends EnergySource {
    public AtomicEnergySource() {
        this.type = EnergyType.ATOMIC;
    }

    @Override
    public void provideEnergy(Robot robot) {
        System.out.println("Атомная энергия заряжена на 50 лет!");
    }
}

