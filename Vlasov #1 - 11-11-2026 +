Сидер для импорта CSV database/seeders/PropertySeeder.php
phpКопировать
<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;

class PropertySeeder extends Seeder
{
    public function run(): void
    {
        $path = database_path('seeders/data/property-data.csv');
        
        if (!file_exists($path)) {
            $this->command->info("CSV file not found at {$path}");
            return;
        }

        $handle = fopen($path, 'r');
        $header = fgetcsv($handle); // Пропускаем заголовок

        $batch = [];
        while (($row = fgetcsv($handle)) !== false) {
            $batch[] = [
                'name' => $row[0],
                'price' => (int)$row[1],
                'bedrooms' => (int)$row[2],
                'bathrooms' => (int)$row[3],
                'storeys' => (int)$row[4],
                'garages' => (int)$row[5],
                'created_at' => now(),
                'updated_at' => now(),
            ];
        }
        fclose($handle);

        DB::table('properties')->insert($batch);
    }
}
Примечание: файл CSV нужно переместить в папку database/seeders/data/.
