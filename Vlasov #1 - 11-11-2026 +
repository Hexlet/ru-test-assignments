<script setup>
import { ref, reactive } from 'vue';
import axios from 'axios';

const form = reactive({
  name: '',
  bedrooms: null,
  bathrooms: null,
  storeys: null,
  garages: null,
  price_from: null,
  price_to: null
});

const results = ref([]);
const loading = ref(false);
const searched = ref(false);

const fetchProperties = async () => {
  loading.value = true;
  searched.value = true;
  
  try {
    const response = await axios.get('/api/properties/search', { params: form });
    results.value = response.data;
  } catch (error) {
    results.value = [];
    console.error(error);
  } finally {
    loading.value = false;
  }
};
</script>

