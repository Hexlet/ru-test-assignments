## Go-клиент (`pkg/client/client.go`)

Клиент реализует `Get`, `Set`, `Remove`, `Keys` поверх TCP.

```go
package client

import (
	"bufio"
	"fmt"
	"net"
	"strconv"
	"strings"
)

type Client struct {
	conn net.Conn
}

func NewClient(addr string) (*Client, error) {
	conn, err := net.Dial("tcp", addr)
	if err != nil {
		return nil, err
	}
	return &Client{conn: conn}, nil
}

func (cl *Client) Close() error {
	return cl.conn.Close()
}

func (cl *Client) Set(key, value string, ttl int) error {
	cmd := fmt.Sprintf("SET %s %s %d\r\n", key, value, ttl)
	_, err := cl.conn.Write([]byte(cmd))
	if err != nil {
		return err
	}

	br := bufio.NewReader(cl.conn)
	line, _ := br.ReadString('\n')
	if strings.HasPrefix(line, "-ERR") {
		return fmt.Errorf("set error: %s", line)
	}
	return nil
}

func (cl *Client) Get(key string) (string, error) {
	cmd := fmt.Sprintf("GET %s\r\n", key)
	_, err := cl.conn.Write([]byte(cmd))
	if err != nil {
		return "", err
	}

	br := bufio.NewReader(cl.conn)
	prefix, err := br.ReadString('\r')
	if err != nil {
		return "", err
	}
	prefix = strings.TrimSuffix(prefix, "\r")

	if strings.HasPrefix(prefix, "-ERR") {
		return "", fmt.Errorf("get error: %s", prefix)
	}

	if prefix == "" {
		return "", fmt.Errorf("empty response")
	}

	lenStr := strings.TrimPrefix(prefix, "$")
	length, err := strconv.Atoi(lenStr)
	if err != nil {
		return "", err
	}

	data := make([]byte, length+2) // +2 for \r\n
	n, err := br.Read(data)
	if err != nil || n != length+2 {
		return "", fmt.Errorf("read error")
	}

	return string(data[:length]), nil
}

func (cl *Client) Remove(key string) error {
	cmd := fmt.Sprintf("DEL %s\r\n", key)
	_, err := cl.conn.Write([]byte(cmd))
	if err != nil {
		return err
	}

	br := bufio.NewReader(cl.conn)
	line, _ := br.ReadString('\n')
	if strings.HasPrefix(line, "-ERR") {
		return fmt.Errorf("del error: %s", line)
	}
	return nil
}

func (cl *Client) Keys() ([]string, error) {
	cmd := "KEYS *\r\n"
	_, err := cl.conn.Write([]byte(cmd))
	if err != nil {
		return nil, err
	}

	br := bufio.NewReader(cl.conn)
	prefix, _ := br.ReadString('\r')
	prefix = strings.TrimSuffix(prefix, "\r")

	if strings.HasPrefix(prefix, "-ERR") {
		return nil, fmt.Errorf("keys error: %s", prefix)
	}

	countStr := strings.TrimPrefix(prefix, "*")
	count, _ := strconv.Atoi(countStr)

	var keys []string
	for i := 0; i < count; i++ {
		p, _ := br.ReadString('\r')
		p = strings.TrimSuffix(p, "\r")
		lenStr := strings.TrimPrefix(p, "$")
		l, _ := strconv.Atoi(lenStr)

		data := make([]byte, l+2)
		n, _ := br.Read(data)
		keys = append(keys, string(data[:l]))
	}

	return keys, nil
}
```

Тесты клиента (`pkg/client/client_test.go`) аналогичны тестам кэша, но используют реальный TCP‑клиент.

