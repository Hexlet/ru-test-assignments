## Сервер и протокол (`cmd/server/main.go`)

Протокол — упрощённый RESP:

- `SET key value [ttl]`
- `GET key`
- `DEL key`
- `KEYS [pattern]` (в этой реализации pattern игнорируется, возвращается все ключи)
- Ответы: `+OK`, `-ERR ...`, `$len\r\nvalue`, `*N` для списков, `%N` для словарей.

```go
package main

import (
	"bufio"
	"fmt"
	"log"
	"net"
	"strconv"
	"strings"

	"juno-cache/pkg/cache"
)

var c = cache.NewCache()

func handleConn(conn net.Conn) {
	defer conn.Close()
	r := bufio.NewReader(conn)

	for {
		line, err := r.ReadString('\n')
		if err != nil {
			return
		}
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}

		parts := strings.Split(line, " ")
		cmd := strings.ToUpper(parts[0])

		var resp []byte
		switch cmd {
		case "SET":
			resp = handleSet(parts)
		case "GET":
			resp = handleGet(parts)
		case "DEL":
			resp = handleDel(parts)
		case "KEYS":
			resp = handleKeys(parts)
		default:
			resp = []byte("-ERR unknown command\r\n")
		}

		conn.Write(resp)
	}
}

func handleSet(parts []string) []byte {
	if len(parts) < 3 {
		return []byte("-ERR wrong number of arguments for 'set'\r\n")
	}
	key, value := parts[1], parts[2]
	ttl := 0
	if len(parts) > 3 {
		v, err := strconv.Atoi(parts[3])
		if err == nil {
			ttl = v
		}
	}

	err := c.Set(key, value, ttl)
	if err != nil {
		return []byte("-ERR " + err.Error() + "\r\n")
	}
	return []byte("+OK\r\n")
}

func handleGet(parts []string) []byte {
	if len(parts) != 2 {
		return []byte("-ERR wrong number of arguments for 'get'\r\n")
	}
	key := parts[1]
	val, err := c.Get(key)
	if err != nil {
		return []byte("-ERR key not found\r\n")
	}

	switch v := val.(type) {
	case string:
		return []byte(fmt.Sprintf("$%d\r\n%s\r\n", len(v), v))
	case []string:
		lines := strings.Join(v, "\r\n")
		return []byte(fmt.Sprintf("*%d\r\n%s", len(v), lines))
	case map[string]string:
		// упрощённо: сериализуем в строку
		var b strings.Builder
		b.WriteString(fmt.Sprintf("%d\r\n", len(v)))
		for k, val := range v {
			b.WriteString(fmt.Sprintf("$%d\r\n%s\r\n$%d\r\n%s\r\n", len(k), k, len(val), val))
		}
		return []byte(b.String())
	default:
		return []byte("-ERR unsupported type\r\n")
	}
}

func handleDel(parts []string) []byte {
	if len(parts) != 2 {
		return []byte("-ERR wrong number of arguments for 'del'\r\n")
	}
	key := parts[1]
	err := c.Remove(key)
	if err != nil {
		return []byte("-ERR key not found\r\n")
	}
	return []byte("+OK\r\n")
}

func handleKeys(parts []string) []byte {
	keys := c.Keys()
	var b strings.Builder
	b.WriteString(fmt.Sprintf("*%d\r\n", len(keys)))
	for _, k := range keys {
		b.WriteString(fmt.Sprintf("$%d\r\n%s\r\n", len(k), k))
	}
	return []byte(b.String())
}

func main() {
	ln, err := net.Listen("tcp", ":6379")
	if err != nil {
		log.Fatal(err)
	}
	defer ln.Close()

	log.Println("Juno Cache server listening on :6379")

	for {
		conn, err := ln.Accept()
		if err != nil {
			log.Println(err)
			continue
		}
		go handleConn(conn)
	}
}
```

> Примечание: порт `6379` выбран для совместимости с привычными Redis‑клиентами, но это не полноценный Redis.

