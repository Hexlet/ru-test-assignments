## Реализация кэша (`pkg/cache/cache.go`)

```go
package cache

import (
	"errors"
	"sync"
	"time"
)

type Cache struct {
	mu      sync.RWMutex
	store   map[string]interface{}
	ttl     map[string]time.Time
}

var (
	ErrKeyNotFound = errors.New("key not found")
	ErrInvalidType = errors.New("invalid value type")
)

func NewCache() *Cache {
	return &Cache{
		store: make(map[string]interface{}),
		ttl:   make(map[string]time.Time),
	}
}

func (c *Cache) Set(key string, value interface{}, ttlSeconds int) error {
	c.mu.Lock()
	defer c.mu.Unlock()

	switch v := value.(type) {
	case string, []string, map[string]string:
		c.store[key] = v
	default:
		return ErrInvalidType
	}

	if ttlSeconds > 0 {
		c.ttl[key] = time.Now().Add(time.Duration(ttlSeconds) * time.Second)
	} else {
		delete(c.ttl, key)
	}
	return nil
}

func (c *Cache) Get(key string) (interface{}, error) {
	c.mu.RLock()
	defer c.mu.RUnlock()

	val, ok := c.store[key]
	if !ok {
		return nil, ErrKeyNotFound
	}

	// Проверка TTL
	if expire, ok := c.ttl[key]; ok && time.Now().After(expire) {
		// Логическое удаление: вызывающий должен очистить
		return nil, ErrKeyNotFound
	}

	return val, nil
}

func (c *Cache) Remove(key string) error {
	c.mu.Lock()
	defer c.mu.Unlock()

	_, ok := c.store[key]
	if !ok {
		return ErrKeyNotFound
	}

	delete(c.store, key)
	delete(c.ttl, key)
	return nil
}

func (c *Cache) Keys() []string {
	c.mu.RLock()
	defer c.mu.RUnlock()

	now := time.Now()
	var res []string
	for k, v := range c.store {
		if expire, ok := c.ttl[k]; ok && now.After(expire) {
			continue // исключаем истёкшие
		}
		res = append(res, k)
		_ = v // чтобы избежать unused warning
	}
	return res
}
```

### Тесты кэша (`pkg/cache/cache_test.go`)

```go
package cache

import (
	"testing"
	"time"
)

func TestSetGetString(t *testing.T) {
	c := NewCache()
	key := "test_key"
	val := "hello"

	if err := c.Set(key, val, 0); err != nil {
		t.Fatalf("Set failed: %v", err)
	}

	got, err := c.Get(key)
	if err != nil {
		t.Fatalf("Get failed: %v", err)
	}

	if s, ok := got.(string); !ok || s != val {
		t.Errorf("Expected %q, got %v", val, got)
	}
}

func TestTTL(t *testing.T) {
	c := NewCache()
	key := "ttl_key"
	val := "expiring"

	if err := c.Set(key, val, 1); err != nil {
		t.Fatalf("Set failed: %v", err)
	}

	time.Sleep(1100 * time.Millisecond)

	_, err := c.Get(key)
	if err == nil {
		t.Error("Expected key to be expired")
	}
}

func TestRemove(t *testing.T) {
	c := NewCache()
	key := "remove_key"

	if err := c.Set(key, "value", 0); err != nil {
		t.Fatalf("Set failed: %v", err)
	}

	if err := c.Remove(key); err != nil {
		t.Fatalf("Remove failed: %v", err)
	}

	_, err := c.Get(key)
	if err == nil {
		t.Error("Expected key not found after Remove")
	}
}

func TestKeys(t *testing.T) {
	c := NewCache()
	c.Set("k1", "v1", 0)
	c.Set("k2", "v2", 0)

	keys := c.Keys()
	if len(keys) != 2 {
		t.Errorf("Expected 2 keys, got %d", len(keys))
	}
}
