При сохранении слова вычисляется его первая буква, определяется корзина, и слово добавляется в соответствующий TreeMap<String, AtomicInteger>, что гарантирует автоматическую сортировку ключей.
3. Параллельная обработка (Требование к минимальным критериям)
Для анализа нескольких файлов одновременно используются Project Loom Virtual Threads (доступны "из коробки" в Spring Boot 3 при использовании Java 21). Это позволяет обрабатывать сотни файлов без создания тяжелых системных потоков.
javaКопировать
@Service
public class TextAnalysisService {
    public Map<FrequencyBucket, SortedMap<String, Integer>> analyzeFiles(List<MultipartFile> files) 
            throws FileProcessingException {
        
        ExecutorService executor = Executors.newVirtualThreadPerTaskExecutor();
        List<CompletableFuture<Map<FrequencyBucket, SortedMap<String, Integer>>>> futures = new ArrayList<>();

        for (MultipartFile file : files) {
            CompletableFuture.supplyAsync(() -> processSingleFile(file), executor)
                .exceptionally(ex -> { throw new FileProcessingException(...); })
                .ifPresent(futures::add);
        }
        
        // Объединение результатов всех файлов
        return futures.stream()
            .map(CompletableFuture::join)
            .reduce(this::mergeResults)
            .orElse(new HashMap<>());
      }
      
