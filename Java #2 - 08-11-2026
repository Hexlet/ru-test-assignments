4. Валидация ASCII (Примечание к условию)
Перед началом чтения потока файла выполняется проверка первых 8 КБ на наличие не-ASCII символов.
javaКопировать
public static void validateAscii(InputStream is) throws IOException {
    try (BufferedInputStream bis = new BufferedInputStream(is)) {
        byte[] buffer = new byte[8192];
        int read = bis.read(buffer);
        if (read > 0) {
            for (int i = 0; i < read; i++) {
                if (buffer[i] < 0) { // Байт со значением >= 128
                    throw new FileProcessingException("File contains non-ASCII characters.");
                }
            }
        }
        // Сброс потока невозможен у MultipartFile, поэтому файл копируется во временный ByteArrayOutputStream
        // или читается один раз целиком в память для валидации перед парсингом.
    }
}
