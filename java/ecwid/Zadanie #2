import java.io.BufferedInputStream
import java.io.FileInputStream
import java.nio.charset.StandardCharsets
import kotlin.math.ln
import kotlin.math.pow

/**
 * Компактная реализация алгоритма HyperLogLog для оценки количества уникальных элементов.
 * Использует только стандартную библиотеку JDK.
 */
class HyperLogLog(private val p: Int = 14) {
    private val m: Int = 1 shl p // Количество регистров (2^p)
    private val registers = ByteArray(m) // Каждый регистр занимает 1 байт (макс. значение < 32 для IPv4)
    private val alphaMM: Double

    init {
        require(p in 4..16) { "Для баланса точности и скорости рекомендуется параметр p от 4 до 16." }
        
        // Коэффициент коррекции смещения (alpha_m)
        alphaMM = when (m) {
            16 -> 0.673
            32 -> 0.697
            64 -> 0.709
            else -> 0.7213 / (1 + 1.079 / m)
        } * m.toDouble() * m.toDouble()
    }

    /** Вычисляет позицию первого установленного бита (справа налево, начиная с 1) */
    private fun rho(w: Int): Int {
        var value = w
        var r = 1
        while ((value and 1) == 0 && r <= 32) {
            value = value ushr 1
            r++
        }
        return r
    }

    /**
     * Добавляет элемент в структуру.
     * Для экономии памяти мы НЕ создаем объект String из строки IP.
     * Мы работаем напрямую с массивом байтов ASCII.
     */
    fun offer(ipBytes: ByteArray, startIdx: Int, length: Int) {
        // Преобразуем строку IP в int вручную. Это быстрее, чем Integer.parseInt на подстроках.
        var ipAsInt = 0
        var part = 0
        var dotCount = 0
        for (i in startIdx until startIdx + length) {
            val b = ipBytes[i].toInt()
            if (b == '.'.code) {
                ipAsInt = ipAsInt shl 8 or part
                part = 0
                dotCount++
            } else {
                part = part * 10 + (b - '0'.code)
            }
        }
        ipAsInt = ipAsInt shl 8 or part

        // Хешируем полученный int. hashCode() у Int детерминирован и имеет хорошее распределение.
        val x = ipAsInt.hashCode()
        
        val j = x ushr (32 - p) // Первые p бит определяют индекс регистра
        val w = (x shl p) or (j.inv() ushr (32 - p)) // Оставшиеся биты для функции rho
        
        val rank = rho(w)
        if (registers[j] < rank.toByte()) {
            registers[j] = rank.toByte()
        }
    }

    /** Возвращает оценку количества уникальных элементов */
    fun cardinality(): Long {
        var sum = 0.0
        for (v in registers) {
            sum += 1.0 / (1L shl v.toInt())
        }
        var estimate = alphaMM / sum

        // Коррекции для малых и больших диапазонов (по оригинальной статье Flajolet et al.)
        if (estimate <= 2.5 * m) {
            val zeros = registers.count { it.toInt() == 0 }
            if (zeros != 0) {
                return (m.toDouble() * ln(m.toDouble() / zeros)).toLong()
            }
        } else if (estimate > (1.0 / 30.0) * (1L shl 32)) {
            return (-(1L shl 32) * ln(1 - estimate / (1L shl 32))).toLong()
        }
        return estimate.toLong()
    }
}

/**
 * Потоковый обработчик огромных файлов. Читает файл буферами,
 * находит границы строк (\n) и передает сырые байты в HyperLogLog.
 */
object UniqueIpCounter {
    @JvmStatic
    fun main(args: Array<String>) {
        if (args.isEmpty()) {
            println("Usage: java -jar counter.jar <path_to_file>")
            return
        }

        val filePath = args[0]
        val hll = HyperLogLog(p = 14) // ~16KB памяти, точность ~1.6%
        
        // Буфер 4 МБ — оптимальный размер для современных SSD/HDD и CPU L2/L3 кэшей
        val bufferSize = 4 * 1024 * 1024 
        val buffer = ByteArray(bufferSize)
        
        FileInputStream(filePath).use { fis ->
            BufferedInputStream(fis).use { bis ->
                var bytesRead: Int
                var lineStart = 0
                
                while (bis.read(buffer).also { bytesRead = it } != -1) {
                    var i = 0
                    while (i < bytesRead) {
                        if (buffer[i] == '\n'.code.toByte()) {
                            // Передаем срез массива byte[start:end], избегая создания новой строки
                            hll.offer(buffer, lineStart, i - lineStart)
                            lineStart = i + 1
                        }
                        i++
                    }
                    // Обработка последней строки в буфере (если файл не заканчивается на \n)
                    if (lineStart < bytesRead && bytesRead == bufferSize) {
                        // Копируем хвост во временный массив, так как следующая итерация перезапишет buffer
                        val tailLength = bytesRead - lineStart
                        System.arraycopy(buffer, lineStart, buffer, 0, tailLength)
                        lineStart = 0
                        // Дочитываем остаток файла поверх скопированного хвоста
                        val nextRead = bis.read(buffer, tailLength, bufferSize - tailLength)
                        if (nextRead != -1) {
                            bytesRead = tailLength + nextRead
                            i = tailLength
                            while (i < bytesRead) {
                                if (buffer[i] == '\n'.code.toByte()) {
                                    hll.offer(buffer, lineStart, i - lineStart)
                                    lineStart = i + 1
                                }
                                i++
                            }
                        } else {
                            // Конец файла
                            if (tailLength > 0) {
                                hll.offer(buffer, lineStart, tailLength)
                            }
                            break
                        }
                    }
                }
                // Если последняя строка в файле не имела перевода строки
                if (bytesRead < bufferSize && lineStart < bytesRead) {
                    hll.offer(buffer, lineStart, bytesRead - lineStart)
                }
            }
        }

        println("Estimated unique IPv4 addresses: ${hll.cardinality()}")
    }
}
Как это работает внутри:
Чтение: Программа открывает поток ввода и читает файл блоками по 4 МБ. Это гарантирует, что потребление RAM останется стабильным (~20 КБ на сам HLL + 4 МБ буфер).
Парсинг: Внутри цикла поиска символа \n программа не создает объекты String. Она берет индексы начала и конца строки в байтовом массиве и конвертирует последовательность цифр ASCII напрямую в Int. Это экономит колоссальное время работы Garbage Collector.
Индексация: Полученный Int хешируется встроенным .hashCode(). Первые 14 бит хеша выбирают один из 
