import java.util.*;

public class AssignmentMain {
    public static void main(String[] args) throws Exception {
        System.out.println("Starting Deep Copy Demo...");

        // 1. Basic structural copy (based on your Man class)
        Man originalMan = new Man("Sherlock Holmes", 40, List.of("A Study in Scarlet", "The Hound of the Baskervilles"));
        ComplexContainer original = new ComplexContainer(originalMan, new byte[]{1, 2, 3}, 
            Map.of("detectives", List.of(originalMan)));

        ComplexContainer copy = DeepCopyUtil.deepCopy(original);

        System.out.println("\n--- Structural Integrity Check ---");
        System.out.println("Original Owner Name: " + original.getOwner().getName());
        System.out.println("Copy Owner Name: " + copy.getOwner().getName());
        System.out.println("Same instances? " + (original.getOwner() == copy.getOwner())); // Should be false
        System.out.println("Names equal? " + Objects.equals(original.getOwner().getName(), copy.getOwner().getName())); // Should be true

        // Verify independence
        copy.getOwner().setName("Dr. Watson");
        copy.getBinaryData()[0] = 99;
        ((ArrayList<String>)copy.getOwner().getFavoriteBooks()).add("The Sign of Four");
        
        System.out.println("\n--- Independence Check ---");
        System.out.println("Original name after copy modification: " + original.getOwner().getName()); // Still Sherlock
        System.out.println("Original binary first byte: " + original.getBinaryData()[0]); // Still 1
        System.out.println("Original books count: " + original.getOwner().getFavoriteBooks().size()); // Still 2

        // 2. Cyclic reference test
        System.out.println("\n--- Cyclic Reference Check ---");
        Node root = new Node("root");
        Node leaf = new Node("leaf");
        root.addChild(leaf);
        
        Node rootCopy = DeepCopyUtil.deepCopy(root);
        System.out.println("Root ID: " + rootCopy.getId());
        System.out.println("Leaf Parent ID: " + rootCopy.getChildren().get(0).getParent().getId());
        System.out.println("Cycle preserved (no StackOverflow): Success");

        // 3. Nested Generics test
        System.out.println("\n--- Nested Generics Check ---");
        Man m1 = new Man("Alice", 30, new ArrayList<>());
        Man m2 = new Man("Bob", 25, new ArrayList<>());
        Map<String, List<Man>> reg = new HashMap<>();
        reg.put("team", List.of(m1, m2));
        
        ComplexContainer cont = new ComplexContainer(m1, new byte[0], reg);
        ComplexContainer contCopy = DeepCopyUtil.deepCopy(cont);
        
        contCopy.getRegistry().get("team").get(0).setAge(31);
        System.out.println("Nested Original Age: " + cont.getRegistry().get("team").get(0).getAge()); // Still 30
        
        System.out.println("\nAll tests passed.");
    }
}
