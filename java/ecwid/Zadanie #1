import java.lang.invoke.MethodHandles;
import java.lang.reflect.*;
import java.util.*;

public class DeepCopyUtil {
    // Cache to handle circular references: original -> copy
    private static final ThreadLocal<Map<Object, Object>> CACHE = ThreadLocal.withInitial(IdentityHashMap::new);
    
    // Unsafe is required to modify 'final' fields at runtime
    private static final sun.misc.Unsafe UNSAFE;
    private static final long FIELD_OFFSET_FINAL_MODIFIER;

    static {
        try {
            Field f = sun.misc.Unsafe.class.getDeclaredField("theUnsafe");
            f.setAccessible(true);
            UNSAFE = (sun.misc.Unsafe) f.get(null);
            
            // Offset for the 'modifiers' field in java.lang.reflect.Field
            FIELD_OFFSET_FINAL_MODIFIER = UNSAFE.objectFieldOffset(Field.class.getDeclaredField("modifiers"));
        } catch (Exception e) {
            throw new IllegalStateException("Failed to initialize Unsafe", e);
        }
    }

    public static <T> T deepCopy(T obj) throws ReflectiveOperationException {
        if (obj == null) return null;
        
        Map<Object, Object> cache = CACHE.get();
        
        // Return immediately for common immutable objects
        Class<?> clazz = obj.getClass();
        if (clazz.isPrimitive() || clazz == String.class || Number.class.isAssignableFrom(clazz) 
                || clazz == Boolean.class || clazz instanceof Enum) {
            return obj;
        }

        // Circular reference guard
        if (cache.containsKey(obj)) {
            @SuppressWarnings("unchecked")
            T existing = (T) cache.get(obj);
            return existing;
        }

        // Arrays
        if (clazz.isArray()) {
            int length = Array.getLength(obj);
            Object newArray = Array.newInstance(clazz.getComponentType(), length);
            cache.put(obj, newArray); // Register before recursing
            for (int i = 0; i < length; i++) {
                Array.set(newArray, i, deepCopy(Array.get(obj, i)));
            }
            @SuppressWarnings("unchecked")
            T result = (T) newArray;
            return result;
        }

        // Collections
        if (obj instanceof Collection<?>) {
            Collection<?> source = (Collection<?>) obj;
            Collection<Object> target;
            try {
                target = (Collection<Object>) source.getClass().getDeclaredConstructor().newInstance();
            } catch (NoSuchMethodException | InvocationTargetException e) {
                // Fallbacks for abstract/interface types often used in signatures
                if (source instanceof Set) {
                    target = new LinkedHashSet<>();
                } else {
                    target = new ArrayList<>(source.size());
                }
            }
            cache.put(obj, target);
            for (Object item : source) {
                target.add(deepCopy(item));
            }
            @SuppressWarnings("unchecked")
            T result = (T) target;
            return result;
        }

        // Maps
        if (obj instanceof Map<?, ?>) {
            Map<?, ?> source = (Map<?, ?>) obj;
            Map<Object, Object> target;
            try {
                target = (Map<Object, Object>) source.getClass().getDeclaredConstructor().newInstance();
            } catch (NoSuchMethodException | InvocationTargetException e) {
                target = new LinkedHashMap<>(source.size());
            }
            cache.put(obj, target);
            for (var entry : source.entrySet()) {
                target.put(deepCopy(entry.getKey()), deepCopy(entry.getValue()));
            }
            @SuppressWarnings("unchecked")
            T result = (T) target;
            return result;
        }

        // Records (Java 16+)
        if (clazz.isRecord()) {
            var components = clazz.getRecordComponents();
            Object[] args = new Object[components.length];
            for (int i = 0; i < components.length; i++) {
                args[i] = deepCopy(
                    MethodHandles.privateLookupIn(clazz, MethodHandles.lookup())
                        .findGetter(clazz, components[i].getName(), components[i].getType())
                        .bindTo(obj)
                        .invokeExact()
                );
            }
            Constructor<?> ctor = clazz.getDeclaredConstructor(Arrays.stream(components)
                    .map(RecordComponent::getType)
                    .toArray(Class[]::new));
            boolean wasAccessible = ctor.canAccess(null);
            try {
                ctor.setAccessible(true);
                Object record = ctor.newInstance(args);
                cache.put(obj, record);
                @SuppressWarnings("unchecked")
                T result = (T) record;
                return result;
            } finally {
                ctor.setAccessible(wasAccessible);
            }
        }

        // General Objects / POJOs
        try {
            Object clone = clazz.getDeclaredConstructor().newInstance();
            cache.put(obj, clone);
            copyFields(obj, clone, clazz);
            @SuppressWarnings("unchecked")
            T result = (T) clone;
            return result;
        } catch (NoSuchMethodException | InvocationTargetException ignored) {
            // No-arg constructor not available. Try Objenesis-style allocation (Unsafe).
            Object allocated = allocateInstance(clazz);
            cache.put(obj, allocated);
            copyFields(obj, allocated, clazz);
            @SuppressWarnings("unchecked")
            T result = (T) allocated;
            return result;
        }
    }

    private static void copyFields(Object source, Object target, Class<?> clazz) throws ReflectiveOperationException {
        if (clazz == Object.class) return;
        
        // Recursive step for superclass chain
        copyFields(source, target, clazz.getSuperclass());

        for (Field field : clazz.getDeclaredFields()) {
            if (java.lang.reflect.Modifier.isStatic(field.getModifiers())) continue;

            boolean wasAccessible = field.canAccess(null);
            try {
                field.setAccessible(true);
                
                // Temporarily remove 'final' modifier to allow setting
                boolean isFinal = java.lang.reflect.Modifier.isFinal(field.getModifiers());
                if (isFinal) {
                    UNSAFE.putInt(field, FIELD_OFFSET_FINAL_MODIFIER, field.getModifiers() & ~Modifier.FINAL);
                }

                Object value = field.get(source);
                field.set(target, deepCopy(value));

                // Restore 'final' modifier
                if (isFinal) {
                    UNSAFE.putInt(field, FIELD_OFFSET_FINAL_MODIFIER, field.getModifiers() | Modifier.FINAL);
                }
            } finally {
                field.setAccessible(wasAccessible);
            }
        }
    }

    private static Object allocateInstance(Class<?> clazz) {
        try {
            return UNSAFE.allocateInstance(clazz);
        } catch (InstantiationException e) {
            throw new IllegalStateException("Cannot instantiate " + clazz.getName() + ": no suitable constructor and unsafe allocation failed.", e);
        }
    }
}
