Пример кода окна списка групп:
import javax.swing.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class GroupsFrame extends JFrame {
    private JButton btnAdd = new JButton("Добавить");
    private JButton btnEdit = new JButton("Редактировать");
    private JButton btnDelete = new JButton("Удалить");
    private JTable tableGroups;

    public GroupsFrame() {
        setTitle("Список групп");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(600, 400);
        
        JPanel panelButtons = new JPanel();
        panelButtons.add(btnAdd);
        panelButtons.add(btnEdit);
        panelButtons.add(btnDelete);
        
        add(panelButtons, BorderLayout.SOUTH);
        
        // Инициализация таблицы и других компонентов...
        
        btnAdd.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                editGroup(null); // Вызываем окно добавления группы
            }
        });
        
        btnEdit.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                int selectedRow = tableGroups.getSelectedRow();
                if (selectedRow != -1) {
                    editGroup((Group)tableGroups.getValueAt(selectedRow, 0));
                } else {
                    JOptionPane.showMessageDialog(GroupsFrame.this, "Выберите группу!");
                }
            }
        });
        
        btnDelete.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                int selectedRow = tableGroups.getSelectedRow();
                if (selectedRow != -1) {
                    deleteGroup((Group)tableGroups.getValueAt(selectedRow, 0));
                } else {
                    JOptionPane.showMessageDialog(GroupsFrame.this, "Выберите группу!");
                }
            }
        });
    }

    private void editGroup(Group group) {
        EditGroupDialog dialog = new EditGroupDialog(this, group);
        dialog.setVisible(true);
    }

    private void deleteGroup(Group group) {
        try {
            dao.delete(group.getId());
            refreshTable(); // Обновляем таблицу после удаления
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Ошибка удаления группы.");
        }
    }

    private void refreshTable() {
        // Метод обновления таблицы
    }
}
